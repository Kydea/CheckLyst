@{
    var Title = "Therapy history";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapies")
    @Html.Partial("components/table", "therapyHistory")
</div>

<script type="text/javascript">
    var
        data = {
            tables: {
                therapies: matematici.data.therapies(true),
                therapyHistory: {
                    log: false,
                    extended: true,
                    label: "history",
                    columns: [
                        { label: "date", cssClass: "Down", centered: true },
                        { label: "state" },
                        { label: "signature" },
                        { label: "reason" }
                    ],
                    rows: [
                        ["2023-01-01", "Proposed", "Mario Rossi"],
                        ["2023-01-01", "In progress", "John Smith"]
                    ]
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: matematici.data.therapiesBreadcrumbs(["therapies", "history"])
        });

        callback.call();
    };
</script>
