@{
    var Title = "Therapy types phases";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapyTypes")
    @Html.Partial("components/table", "therapyTypePhases")
</div>

<script type="text/javascript">
    var
        data = {
            blocks: [
                {
                    fields: [
                        { label: "order", icon: "key", value: "1", editable: false }
                    ]
                },
                {
                    fields: [
                        { label: "manufacturing phase", values: ["collection", "sequencing", "cell pre-processing", "plasmid manufacturing", "genetic vector manufacturing", "cell manufacturing", "treatment", "follow up"] },
                        { label: "made to stock", value: false },
                        { label: "starting", value: "0", um: "days" },
                        { label: "duration", value: "0", um: "days" },
                        { label: "deadline", value: "-", um: "days" },
                        { label: "payment threeshold", value: "150.000,00", um: "&euro;" },
                        { label: "centers", values: ["Hospital 1", "Pharma Center 1", "Pharma Center 2", "Uncommon Center", "Nearby Center"], class: "Clearing", cssClass: "Width400", selectedIndexes: [0] },
                        { label: "note", value: "", class: "Clearing", area: true, cssClass: "Width400"},
                    ]
                },
                {
                    emphasy: true,
                    fields: [
                        { label: "created by", editable: false, value: "2023-01-01 15:10:08" },
                        { label: "created on", editable: false, value: "john smith" },
                        { label: "modified by", editable: false },
                        { label: "modified on", editable: false }
                    ]
                }
            ],
            tables: {
                therapyTypes: matematici.data.therapyTypes(true),
                therapyTypePhases: {
                    label: "phases",
                    columns: [
                        { label: "", cssClass: "Down" },
                        { label: "manufacturing phase" },
                        { label: "made to stock", cssClass: "Tight" },
                        { label: "starting", um: "days" },
                        { label: "duration", um: "days" },
                        { label: "deadline", um: "days" },
                        { label: "note", cssClass: "Tight" },
                        { label: "payment threeshold", um: "&euro;", cellCssClass: "Right" },
                        { label: "centers" }
                    ],
                    rows: [
                        ["1", "collection", false, "0", "0", "-", "", "150.000,00", "Hospital 1"],
                        ["2", "cell pre-processing", false, "1", "1", "-", "", "-", "Nearby Center"],
                        ["3", "plasmid manufacturing", true, "-", "-", "-", "", "-", "<span class=\"counter\">2</span> Pharma center 1, Pharma center 2"],
                        ["4", "genetic vector manufacturing", true, "-", "-", "-", "", "", "<span class=\"counter\">3</span> Pharma center 1, Pharma center 2, Uncommon center"],
