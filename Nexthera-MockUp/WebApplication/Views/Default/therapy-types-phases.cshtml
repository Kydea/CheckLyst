                        ["6", "treatment", false, "8", "1", "10", "", "-", "Hospital 1"],
                        ["7", "follow up", false, "30", "2", "-", "", "250.000,00", "Hospital 1"],
                        ["8", "follow up", false, "150", "1", "-", "", "300.000,00", "Hospital 1"],
                        ["9", "follow up", false, "300", "1", "-", "", "350.000,00", "Hospital 1"]
                    ]
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: [
                {
                    items: [
                        { label: "therapy types", url: "/therapy-types", selected: true }
                    ]
                },
                {
                    items: [
                        { label: "phases", url: "/therapy-types-phases", selected: true },
                        { label: "payment plan", url: "/therapy-types-payment-plan" },
                        { label: "shippings", url: "/therapy-types-shippings" },
                        { label: "process", url: "/therapy-types-process" }
                    ]
                }
            ]
        });

        callback.call();
    };
</script>
