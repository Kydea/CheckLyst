@{
    var Title = "Therapy type matherial parameters";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapyTypes")
    @Html.Partial("components/table", "therapyTypeMaterials")
    @Html.Partial("components/table", "therapyTypeMaterialParameters")
</div>

<script type="text/javascript">
    var
        data = {
            blocks: [
                {
                    fields: [
                        { label: "parameter", values: ["temperature", "pressure", "shock"] },
                        { label: "unit of measure", value: "kelvin", editable: false },
                        { label: "lower bound", value: "253", cssClass: "Clearing" },
                        { label: "upper bound", value: "283" },
                        { label: "iot interface", value: true }
                    ]
                },
                {
                    emphasy: true,
                    fields: [
                        { label: "created by", editable: false, value: "2023-01-01 15:10:08" },
                        { label: "created on", editable: false, value: "john smith" },
                        { label: "modified by", editable: false },
                        { label: "modified on", editable: false }
                    ]
                }
            ],
            tables: {
                therapyTypes: matematici.data.therapyTypes(true),
                therapyTypeMaterials: {
                    compact: true,
                    label: "matherials",
                    columns: [
                        { label: "material", cssClass: "Down" },
                        { label: "material code" },
                        { label: "material code editable" },
                        { label: "unit of measure" },
                        { label: "quantity" },
                    ],
                    rows: [
                        ["blood", "{COII}-01", false, "cc", "150"],
                        ["plasmids", "pl123", false, "cc", "1"],
                        ["genetic vectors", "gv321", false, "cc", "2"],
                        ["therapy", "{COII}-02", false, "CC", "30"]
                    ]
                },
                therapyTypeMaterialParameters: {
                    label: "paramters",
                    columns: [
                        { label: "parameter", cssClass: "Down" },
                        { label: "unit of measure" },
                        { label: "lower bound" },
                        { label: "upper bound" }
                    ],
                    rows: [
                        ["temperature", "Kelvin", "253", "283"],
                        ["pressure", "pascal", "101200", "101400"],
                        ["shock", "Ns", "-2.2e5", "+2.2e5"]
                    ]
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: matematici.data.therapyTypesBreadcrumbs(["therapy types", "materials", "parameters"])
        });

        callback.call();
    };
</script>
