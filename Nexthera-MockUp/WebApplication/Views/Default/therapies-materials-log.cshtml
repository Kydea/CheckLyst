@{
    var Title = "Therapy material log";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapies")
    @Html.Partial("components/table", "therapyMaterials")
    @Html.Partial("components/table", "therapyMaterialLog")
</div>

<script type="text/javascript">
    var
        showLog = function () {
            matematici.popup.show("test", $("div#therapies").clone());
        },
        data = {
            tables: {
                therapies: matematici.data.therapies(true),
                therapyMaterials: {
                    compact: true,
                    label: "materials",
                    columns: [
                        { label: "material", cssClass: "Down" },
                        { label: "material code", width: 180 },
                        { label: "material code editable", width: 150 },
                        { label: "unit of measure" },
                        { label: "quantity" },
                    ],
                    rows: [
                        ["blood", "A0001-23-00AA01-01", false, "cc", "150"],
                        ["plasmids", "pl123", false, "cc", "1"],
                        ["genetic vectors", "gv321", false, "cc", "2"],
                        ["therapy", "A0001-23-00AA01-02", false, "cc", "30"]
                    ]
                },
                therapyMaterialLog: {
                    extended: true,
                    label: "log",
                    log: false,
                    selectedIndex: -1,
                    columns: [
                        { label: "measuremente date", cssClass: "Down" },
                        { label: "material" },
                        { label: "material code" },
                        { label: "parameter" },
                        { label: "unit of measure" },
                        { label: "lower bound", cellCssClass: "Right" },
                        { label: "upper bound", cellCssClass: "Right" },
                        { label: "value", cellCssClass: "Right" }
                    ],
                    rows: []
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {

        for (var hour = 23; hour >= 10; --hour) 
            for (var minute = 59; minute >= 10; --minute) {
                var date = "2023-02-01 " + hour + ":" + minute + ":" + (Math.round(Math.random() * 50, 0) + 10);
                data.tables.therapyMaterialLog.rows.push([date, "blood", "A0001-23-00AA01-01", "temperature", "kelvin", "253", "283", 253 + + Math.round(Math.random() * 20, 0)]);
                data.tables.therapyMaterialLog.rows.push([date, "blood", "A0001-23-00AA01-01", "pressure", "pascal", "101200", "101400", 101200 + + Math.round(Math.random() * 200, 0)]);
                data.tables.therapyMaterialLog.rows.push([date, "blood", "A0001-23-00AA01-01", "shock", "Ns", "-2.2e5", "+2.2e5", "-2.2e5"]);
            }

        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: matematici.data.therapiesBreadcrumbs(["therapies", "materials", "log"])
        });

        callback.call();
    };
</script>
