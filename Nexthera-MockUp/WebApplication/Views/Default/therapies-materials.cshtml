@{
    var Title = "Therapy materials";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapies")
    @Html.Partial("components/table", "therapyMaterials")
</div>

<script type="text/javascript">
    var
        data = {
            blocks: [
                {
                    fields: [
                        { label: "material", value: "blood", cssClass: "Clearing", editable: false },
                        { label: "material code", value: "", editable: false },
                        { label: "material code editable", value: false, editable: false },
                        { label: "unit of measure", value: "cc", editable: false, cssClass: "Clearing" },
                        { label: "quantity", value: "150", editable: false }
                    ]
                },
                {
                    emphasy: true,
                    fields: [
                        { label: "created by", editable: false, value: "2023-01-01 15:10:08" },
                        { label: "created on", editable: false, value: "john smith" },
                        { label: "modified by", editable: false },
                        { label: "modified on", editable: false }
                    ]
                }
            ],
            tables: {
                therapies: matematici.data.therapies(true),
                therapyMaterials: {
                    label: "matherials",
                    columns: [
                        { label: "material", cssClass: "Down" },
                        { label: "material code", width: 180 },
                        { label: "material code editable", width: 150, cellCssClass: "Right" },
                        { label: "unit of measure" },
                        { label: "quantity", cellCssClass: "Right" },
                    ],
                    rows: [
                        ["blood", "A0001-23-00AA01-01", false, "cc", "150"],
                        ["plasmids", "pl123", false, "cc", "1"],
                        ["genetic vectors", "gv321", false, "cc", "2"],
                        ["therapy", "A0001-23-00AA01-02", false, "cc", "30"]
                    ]
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: matematici.data.therapiesBreadcrumbs(["therapies", "materials"])
        });

        callback.call();
    };
</script>
