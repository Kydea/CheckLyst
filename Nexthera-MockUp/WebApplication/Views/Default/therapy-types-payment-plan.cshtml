@{
    var Title = "Therapy type payment plan";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapyTypes")
    @Html.Partial("components/table", "therapyTypePaymentPlan")
</div>

<script type="text/javascript">
    var
        data = {
            blocks: [
                {
                    fields: [
                        { label: "days", value: "0" },
                        { label: "amount", value: "150.000,00" }
                    ]
                },
                {
                    emphasy: true,
                    fields: [
                        { label: "created by", editable: false, value: "2023-01-01 15:10:08" },
                        { label: "created on", editable: false, value: "john smith" },
                        { label: "modified by", editable: false },
                        { label: "modified on", editable: false }
                    ]
                }
            ],
            tables: {
                therapyTypes: matematici.data.therapyTypes(true),
                therapyTypePaymentPlan: {
                    label: "payment plan",
                    columns: [
                        { label: "days", cssClass: "Down", cellCssClass: "Right" },
                        { label: "expecting amount", um: "&euro", cellCssClass: "Right" }
                    ],
                    rows: [
                        ["0", "150.000,00"],
                        ["15", "100.000,00"],
                        ["120", "50.000,00"],
                        ["180", "50.000,00"]
                    ]
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: matematici.data.therapyTypesBreadcrumbs(["therapy types", "payment plan"])
        });

        callback.call();
    };
</script>
