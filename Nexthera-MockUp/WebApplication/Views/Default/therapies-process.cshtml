@{
    var Title = "Therapy process";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="FlowChart"></div>

<div class="Tables">
    @Html.Partial("components/table", "therapies")
</div>

<script type="text/javascript">
    var
        data = {
            tables: {
                therapies: matematici.data.therapies(true)
            }
        },
        graphData = {
            pipes: [
                {
                    nodes: [
                        { id: 1, label: "collection", center: "Hospital 1", duration: "0 days", startedOn: "2023-02 - 01 10: 50: 18", completedOn: "2023-02 - 01 10: 50: 18" },
                        { id: 6, label: "treatment", center: "Hospital 1", duration: "1 day", startedOn: null },
                        { id: 7, label: "follow up", center: "Hospital 1", duration: "2 days", startedOn: null },
                        { id: 8, label: "follow up", center: "Hospital 1", duration: "1 day", startedOn: null },
                        { id: 9, label: "follow up", center: "Hospital 1", duration: "1 day", startedOn: null }
                    ]
                },
                {
                    nodes: [
                        { id: 2, label: "cell-preprocessing", center: "Nearby Center", startedOn: "2023-02-02 18:50:18", completedOn: "2023-02-01 07:51:38" },
                        { id: 5, label: "cell manufacturing", center: "Pharma center 1", startedOn: "2023-03-01 11:35:24" },
                    ]
                },
                {
                    nodes: [
                        { id: 3, label: "plasmid manufacturing", center: "Pharma center 2", startedOn: null, madeToStock: true },
                        { id: 4, label: "genetic vector manufacturing", center: "Pharma center 1", startedOn: null, madeToStock: true },
                    ]
                }
            ],
            paths: [
                { sourceId: 1, destinationId: 2, sourcePosition: "r", destinationPosition: "l", label: "0 days" },
                { sourceId: 2, destinationId: 5, sourcePosition: "b", destinationPosition: "t", label: "1 day" },
                { sourceId: 3, destinationId: 5, sourcePosition: "l", destinationPosition: "r", label: "1 day", destinationBias: ".20" },
                { sourceId: 4, destinationId: 5, sourcePosition: "l", destinationPosition: "r", label: "0 days", sourceBias: ".80", destinationBias: ".67", cssClass: "Dashed" },
                { sourceId: 5, destinationId: 6, sourcePosition: "l", destinationPosition: "r", label: "1 day" },
                { sourceId: 6, destinationId: 7, sourcePosition: "b", destinationPosition: "t", label: "1 day" },
                { sourceId: 7, destinationId: 8, sourcePosition: "b", destinationPosition: "t", label: "1 day" },
                { sourceId: 8, destinationId: 9, sourcePosition: "b", destinationPosition: "t", label: "1 day" },
            ]
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data),
                new matematici.FlowChart(".FlowChart", graphData)
            ],
            breadcrumbs: [
                {
                    items: [
                        { label: "therapies", url: "/therapies", selected: true }
                    ]
                },
                {
                    items: [
                        { label: "phases", url: "/therapies-phases" },
                        { label: "payment plan", url: "/therapies-payment-plan" },
                        { label: "payment plan", url: "/therapies-payments" },
                        { label: "shippings", url: "/therapies-shippings" },
                        { label: "history", url: "/therapies-history" },
                        { label: "process", url: "/therapies-process", selected: true },
                        { label: "coi/coc", url: "/therapies-coi-coc" }
                    ]
                }
            ]
        });

        callback.call();
    };
</script>
