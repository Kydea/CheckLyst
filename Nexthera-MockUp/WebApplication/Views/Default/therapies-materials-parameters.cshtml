@{
    var Title = "Therapy material parameters";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapies")
    @Html.Partial("components/table", "therapyMaterials")
    @Html.Partial("components/table", "therapyMaterialParameters")
</div>

<script type="text/javascript">
    var
        showLog = function () {
            matematici.popup.show("test", $("div#therapies").clone());
        },
        data = {
            blocks: [
                {
                    fields: [
                        { label: "parameter", values: ["temperature", "pressure", "shock"] },
                        { label: "unit of measure", value: "kelvin", editable: false },
                        { label: "lower bound", value: "253", cssClass: "Clearing", editable: false },
                        { label: "upper bound", value: "283", editable: false },
                        { label: "iot interface", value: true, editable: false },
                        { label: "lower value", value: "273", editable: false },
                        { label: "upper bound", value: "278", editable: false },
                        { label: "signed by", value: "", cssClass: "Clearing", editable: false },
                        { label: "signed on", value: "", editable: false },
                        { label: "sign", icon: "arrow-right", handler: function () { console.log("to do") } }
                    ]
                },
                {
                    emphasy: true,
                    fields: [
                        { label: "created by", editable: false, value: "2023-01-01 15:10:08" },
                        { label: "created on", editable: false, value: "john smith" },
                        { label: "modified by", editable: false },
                        { label: "modified on", editable: false }
                    ]
                }
            ],
            tables: {
                therapies: matematici.data.therapies(true),
                therapyMaterials: {
                    compact: true,
                    label: "materials",
                    columns: [
                        { label: "material", cssClass: "Down" },
                        { label: "material code", width: 180 },
                        { label: "material code editable", width: 150 },
                        { label: "unit of measure" },
                        { label: "quantity" },
                    ],
                    rows: [
                        ["blood", "A0001-23-00AA01-01", false, "cc", "150"],
                        ["plasmids", "pl123", false, "cc", "1"],
                        ["genetic vectors", "gv321", false, "cc", "2"],
                        ["therapy", "A0001-23-00AA01-02", false, "CC", "30"]
                    ]
                },
                therapyMaterialParameters: {
                    label: "paramters",
                    columns: [
                        { label: "parameter", cssClass: "Down" },
                        { label: "unit of measure" },
                        { label: "lower bound" },
                        { label: "upper bound" },
                        { label: "lower value" },
                        { label: "upper value" },
                        { label: "signed by", width: 180 },
                        { label: "signed on", width: 180 }
                    ],
                    rows: [
                        ["temperature", "Kelvin", "253", "283", "273", "278", "", ""],
                        ["pressure", "pascal", "101200", "101400", "101325", "101327", "John Snow", "2023-02-01 12:20:01"],
                        ["shock", "Ns", "-2.2e5", "+2.2e5", "-1.2e5", "+1.8e5", "John Snow", "2023-02-01 12:20:01"]
                    ]
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: matematici.data.therapiesBreadcrumbs(["therapies", "materials", "parameters"])
        });

        callback.call();
    };
</script>
