@{
    var Title = "Therapy shippings";
    ViewBag.Title = Title;
}

<h1>@Title</h1>

@Html.Partial("components/toolbar")

<div class="Tables">
    @Html.Partial("components/table", "therapies")
    @Html.Partial("components/table", "therapyShippings")
</div>

<script type="text/javascript">
    var
        data = {
            blocks: [
                {
                    fields: [
                        { label: "source", values: ["1: collection", "2: cell pre-processing", "3: plasmid manufacturing", "4: genetic vector manufacturing", "5: cell manufacturing", "6: treatment", "7: follow up", "8: follow up", "9: follow up"] },
                        { label: "destination", values: ["1: collection", "2: cell pre-processing", "3: plasmid manufacturing", "4: genetic vector manufacturing", "5: cell manufacturing", "6: treatment", "7: follow up", "8: follow up", "9: follow up"], selectedIndex: 1 },
                        { label: "carrier", values: ["SDA", "FedEx"], selectedIndex: 0, cssClass: "Clearing Width200" },
                        { label: "tracking number", value: "HPT63535AN" },
                        { label: "expected duration", value: "0", um: "days", editable: false },
                        { label: "shipped on", value: "2023-01-01", cssClass: "Clearing", editable: false },
                        { label: "shipping signature", value: "Karl Von Fersen", editable: false },
                        { label: "mark as shipped", icon: "arrow-right", handler: function () { console.log("to do") } },
                        { label: "arrived on", value: "", cssClass: "Clearing", editable: false },
                        { label: "arrival signature", value: "", editable: false },
                        { label: "mark as arrived", icon: "arrow-right", handler: function () { console.log("to do") } },
                        { label: "material", value: "blood", cssClass: "Clearing", editable: false },
                        { label: "material code", value: "", editable: false },
                        { label: "unit of measure", value: "cc", editable: false },
                        { label: "quantity", value: "150", editable: false }
                    ]
                },
                {
                    emphasy: true,
                    fields: [
                        { label: "created by", editable: false, value: "2023-01-01 15:10:08" },
                        { label: "created on", editable: false, value: "john smith" },
                        { label: "modified by", editable: false },
                        { label: "modified on", editable: false }
                    ]
                }
            ],
            tables: {
                therapies: matematici.data.therapies(true),
                therapyShippings: {
                    label: "shippings",
                    columns: [
                        { label: "path", cssClass: "Down", centered: true },
                        { label: "carriers" },
                        { label: "expected duration", um: "days", width: 150 },
                        { label: "material", width: 280 },
                        { label: "shipped on", width: 180 },
                        { label: "arrived on", width: 180 }
                    ],
                    rows: [
                        ["1 <i class=\"fa fa-caret-right\"></i> 2", "SDA", "0", "blood (150 cc)", "2023-01-01"],
                        ["2 <i class=\"fa fa-caret-right\"></i> 5", "SDA", 1, "blood (150 cc)"],
                        ["3 <i class=\"fa fa-caret-right\"></i> 5", "SDA", 1, "plasmids - pl123 (1 cc)"],
                        ["4 <i class=\"fa fa-caret-right\"></i> 5", "<span class=\"Note\">(same center)</span>", "0", "genetic vectors - gv321 (2 cc)"],
                        ["5 <i class=\"fa fa-caret-right\"></i> 6", "SDA", 1, "therapy (30cc)"]
                    ]
                }
            }
        };

    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "@Title",
            helpPage: "@Title",
            initializers: [
                new matematici.Nexthera(data)
            ],
            breadcrumbs: matematici.data.therapiesBreadcrumbs(["therapies", "shippings"])
        });

        callback.call();
    };
</script>
