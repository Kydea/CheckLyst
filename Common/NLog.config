<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" autoReload="true">
	<targets>
		<target name="debug"
				xsi:type="EventLog"
				layout="${aspnet-request:header=X-Amzn-Trace-Id}${newline}${longdate}|${level:uppercase=true}|${logger}${newline}${message}"
				log="Application"
				source="CheckListManager"
				machineName="." />
		<target name="warning"
				xsi:type="EventLog"
				layout="${aspnet-request:header=X-Amzn-Trace-Id}${newline}${longdate}|${level:uppercase=true}|${logger}${newline}${message}${newline}${exception:innerFormat=ToString:maxInnerExceptionLevel=5:innerExceptionSeparator=;:separator=-:format=ToString}"
				log="Application"
				source="CheckListManager"
				machineName="." />
	</targets>
	<rules>
		<logger name="*" minlevel="Debug" writeTo="debug" /> <!-- Enable in case is needed -->
		<logger name="*" minlevel="Warn" writeTo="warning" />
	</rules>
</nlog>
