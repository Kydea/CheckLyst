@{
    ViewBag.Title = "User summary";
}

<div class="InstanceOverview">
    <h1>User summary</h1>

    <div class="ActionBar">
        <a id="ListButton" href="#" class="Button"><i class="Icon fa fa-list"></i> List</a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Instances/List">
            <label class="Width200">
                <span>Login refrence</span>
                <input type="text" name="from" class="DatePicker" />
            </label>
        </form>
    </div>
    <div class="ShadowPanel Hidden" id="Result">
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new instances.Overview("form#Filters", "Result");
        callback.call();
    };
</script>
