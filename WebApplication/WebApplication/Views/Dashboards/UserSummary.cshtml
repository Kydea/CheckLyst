@{
    ViewBag.Title = "User summary";
}

<div class="UserSummary">
    <h1>User summary</h1>

    <div class="ActionBar">
        <a id="ExportDataButton" href="#" class="Button"><i class="Icon fa fa-caret-down"></i>Export data</a>
        <a id="SaveGraphButton" href="#" class="Button"><i class="Icon fa fa-chart-bar"></i>Save graph</a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/AccessControl/Users">
            <label class="Width200">
                <span>Active users reference</span>
                <input type="text" name="from" class="DatePicker" />
            </label>
        </form>

        <div class="TabContainer Quick">
            <div class="TabLabels">
                <a href="#">Graph</a>
                <a href="#">Data</a>
            </div>
            <div class="Tab Padded">
                <div class="ChartContainer">
                    <canvas id="chart"></canvas>
                </div>
            </div>
            <div class="Tab Padded" ">
                <table class="Grid">
                    <thead>
                        <tr>
                            <th>Company ID</th>
                            <th>Company description</th>
                            <th>Total users</th>
                            <th>Active users</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td data-column="companyID"></td>
                            <td data-column="companyDescription"></td>
                            <td data-column="totalUsers" class="Right"></td>
                            <td data-column="activeUsers" class="Right"></td>
                        </tr>
                        <tr class="NoRecord"><td>(no record)</td></tr>
                    </tbody>
                </table>
                <div class="Clearing"></div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
var
    selector = ".UserSummary",
    formSelector = "form#Filters",
    chart,
    tab,
    data,

    filterHandler = function (response) {
        data = response.data;
        const labels = response.data.map(item => item.companyDescription);
        const ctx = document.getElementById("chart");

        const datasets = [
            {
                label: "Total",
                data: response.data.map(item => item.totalUsers),
                backgroundColor: "#4472c4"
            },
            {
                label: "Active",
                data: response.data.map(item => item.activeUsers),
                backgroundColor: "#009688"
            }
        ];

        if (!chart) {
            chart = new Chart(ctx, {
                type: "bar",
                data: {
                    labels,
                    datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        title: {
                            display: true,
                            text: "Users",
                            font: {
                                size: 22,
                                weight: "bold"
                            }
                        },
                        legend: {
                            position: "bottom"
                        }
                    },

                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: "Site"
                            },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: "User number"
                            }
                        }
                    }
                }
            });
        } else {
            chart.data.labels = labels;
            chart.data.datasets = datasets;
            chart.update();
        }
    };

    matematici.events.onPageLoad = function (callback) {
        var searchPage = new matematici.SearchPage({
            pageName: "Users",
            detailUrl: "@Url.Action("UserSummary")",
            filterFormSelector: formSelector,
            resultGridSelector: "div#Content table.Grid",
            readOnly: true,
            getDataEvent: "Summary",
            breadCrumbs: [
                { content: "user summary" }
            ],
            filterHandler: filterHandler
        });

        tab = new matematici.Tab(selector + " div.TabContainer", {
            observedElements: [ ".ChartContainer" ]
        });

        $("input[name=from]").val(new Date(new Date().setFullYear(new Date().getFullYear() - 1)).toLocaleDateString("sv-SE"));

        callback.call();

        searchPage.trigger();
    };

    matematici.events.onPageUnload = function (callback) {
        if (chart) {
            chart.destroy();
            chart = null;
        }

        data = null;

        tab.clearObservedElements();

        callback.call();
    };

    $("#ExportDataButton").on("click", function (e) {
        if (!data) return;

        var table = document.querySelector("div#Content table.Grid");

        if (!table)
            return;

        var headers = Array.from(table.querySelectorAll("thead th"));
        var dataRow = table.querySelector("tbody tr:not(.NoRecord)");

        if (!dataRow)
            return;

        var columns = Array.from(dataRow.querySelectorAll("td[data-column]")).map(function (cell, index) {
            return {
                header: headers[index] ? headers[index].textContent.trim() : cell.getAttribute("data-column"),
                field: cell.getAttribute("data-column")
            };
        });

        var escapeCsv = function (value) {
            if (value === null || value === undefined)
                return "";

            value = String(value).replace(/"/g, '""');

            if (
                value.indexOf(";") >= 0 ||
                value.indexOf('"') >= 0 ||
                value.indexOf("\n") >= 0 ||
                value.indexOf("\r") >= 0
            )
                return '"' + value + '"';

            return value;
        };

        var rows = [];

        rows.push(columns.map(function (column) {
            return escapeCsv(column.header);
        }).join(";"));

        for (var i = 0; i < data.length; i++) {
            rows.push(columns.map(function (column) {
                return escapeCsv(data[i][column.field]);
            }).join(";"));
        }

        var today = new Date().toLocaleDateString("sv-SE");
        var csv = "\ufeffsep=;\r\n" + rows.join("\r\n");
        var csvBlob = new Blob([csv], { type: "text/csv;charset=utf-8;" });

        var csvLink = document.createElement("a");
        csvLink.href = URL.createObjectURL(csvBlob);
        csvLink.download = "user-summary-" + today + ".csv";
        csvLink.click();

        URL.revokeObjectURL(csvLink.href);
    });

    $("#SaveGraphButton").on("click", function (e) {
        e.preventDefault();
        if (chart) {
            var sourceCanvas = chart.canvas;
            var today = new Date().toLocaleDateString("sv-SE");

            var exportCanvas = document.createElement("canvas");
            exportCanvas.width = sourceCanvas.width;
            exportCanvas.height = sourceCanvas.height;

            var ctx = exportCanvas.getContext("2d");

            ctx.fillStyle = "#ffffff";
            ctx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);

            ctx.drawImage(sourceCanvas, 0, 0);

            var chartLink = document.createElement("a");
            chartLink.href = exportCanvas.toDataURL("image/png");
            chartLink.download = "user-summary-chart-" + today + ".png";
            chartLink.click();
        }
    });

</script>