@{
    ViewBag.Title = "Instance summary";
}

<div class="InstanceSummary">
    <h1>Instance summary</h1>

    <div class="ActionBar"></div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Instances/List">
            <label>
                <span>Period</span>
                <i class="Icon fal fa-calendar-alt"></i>
                <select name="period" data-nullable="(always)">
                    <option value="year">last year</option>
                    <option value="six-months">last six-months</option>
                    <option value="month">last month</option>
                    <option value="week">last week</option>
                </select>
            </label>
        </form>

        <div class="TabContainer Quick">
            <div class="TabLabels">
                <a href="#">Graph</a>
                <a href="#">Data</a>
            </div>
            <div class="Tab Padded">
                <div class="ChartContainer">
                    <canvas id="chart"></canvas>
                </div>
            </div>
            <div class="Tab Padded"">
                <table class="Grid">
                    <thead>
                        <tr>
                            <th>Company ID</th>
                            <th>Company description</th>
                            <th>Total instances</th>
                            <th>In progress instances</th>
                            <th>Copleted instances</th>
                            <th>Confirmed instances</th>
                            <th>Deleted instances</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td data-column="companyID"></td>
                            <td data-column="companyDescription"></td>
                            <td data-column="totalInstances" class="Right"></td>
                            <td data-column="inProgressInstances" class="Right"></td>
                            <td data-column="completedInstances" class="Right"></td>
                            <td data-column="confirmedInstances" class="Right"></td>
                            <td data-column="deletedInstances" class="Right"></td>
                        </tr>
                        <tr class="NoRecord"><td>(no record)</td></tr>
                    </tbody>
                </table>
                <div class="Clearing"></div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
var
    selector = ".InstanceSummary",
    formSelector = "form#Filters",
    chart,
    tab,

    filterHandler = function (response) {
        const labels = response.data.map(item => item.companyDescription);
        const ctx = document.getElementById("chart");

        const datasets = [
            {
                label: "Total",
                data: response.data.map(item => item.totalInstances),
                backgroundColor: "#4472c4"
            },
            {
                label: "In progress",
                data: response.data.map(item => item.inProgressInstances),
                backgroundColor: "#ffba00"
            },
            {
                label: "Completed",
                data: response.data.map(item => item.completedInstances),
                backgroundColor: "#03c3b1"
            },
            {
                label: "Confirmed",
                data: response.data.map(item => item.confirmedInstances),
                backgroundColor: "#009688"
            },
            {
                label: "Deleted",
                data: response.data.map(item => item.deletedInstances),
                backgroundColor: "#cc0000"
            }
        ];

        if (!chart) {
            chart = new Chart(ctx, {
                type: "bar",
                data: {
                    labels,
                    datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        title: {
                            display: true,
                            text: "Instances",
                            font: {
                                size: 22,
                                weight: "bold"
                            }
                        },
                        legend: {
                            position: "bottom"
                        }
                    },

                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: "Site"
                            },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: "Instance number"
                            }
                        }
                    }
                }
            });
        } else {
            chart.data.labels = labels;
            chart.data.datasets = datasets;
            chart.update();
        }
    };

    matematici.events.onPageLoad = function (callback) {
        var searchPage = new matematici.SearchPage({
            pageName: "Users",
            detailUrl: "@Url.Action("InstanceSummary")",
            filterFormSelector: formSelector,
            resultGridSelector: "div#Content table.Grid",
            readOnly: true,
            getDataEvent: "Summary",
            breadCrumbs: [
                { content: "instance summary" }
            ],
            filterHandler: filterHandler
        });

        tab = new matematici.Tab(selector + " div.TabContainer", {
            observedElements: [ ".ChartContainer" ]
        });

        callback.call();

        searchPage.trigger();
    };

    matematici.events.onPageUnload = function (callback) {
        if (chart) {
            chart.destroy();
            chart = null;
        }

        tab.clearObservedElements();

        callback.call();
    };
</script>