@{
    ViewBag.Title = "Tasks";
}

<div class="Tasks">
    <h1>Tasks</h1>

    <div class="ActionBar">
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Instances/List">
            <label class="Controls1-2">
                <span>Department / prototype type</span>
                <i class="Icon fal fa-industry"></i>
                <select name="department" class="Trigger" data-nullable="(all)"></select>
                <i class="Icon fal fa-folder"></i>
                <select name="prototypeType" class="Trigger" data-nullable="(all)"></select>
            </label>
            <label class="Controls2-1">
                <span>Prototype / version</span>
                <i class="Icon fal fa-file-invoice"></i>
                <select name="prototype" class="Trigger" data-nullable="(all)"></select>
                <i class="Icon fal fa-list-ol"></i>
                <select name="version" class="Trigger" data-nullable="(all)"></select>
            </label>
            <label>
                <span>Instance ID</span>
                <i class="Icon fal fa-key"></i>
                <input type="text" name="id" class="mask-pint" maxlength="18" />
            </label>
        </form>
    </div>
    <div class="ShadowPanel Hidden" id="Result">
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new instances.Tasks("form#Filters", "Result");
        callback.call();
    };
</script>
