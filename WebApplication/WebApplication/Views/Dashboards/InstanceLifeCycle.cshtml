@{
    ViewBag.Title = "Instance life cycle";
}

<div class="InstanceLifeCycle">
    <h1>Instance life cycle</h1>

    <div class="ActionBar">
        <a id="ListButton" href="#" class="Button"><i class="Icon fa fa-list"></i> List</a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Instances/List">
            <label class="Controls1-2">
                <span>Department / prototype type</span>
                <i class="Icon fal fa-industry" />
                <select name="department" class="Trigger" data-nullable="(all)" />
                <i class="Icon fal fa-folder" />
                <select name="prototypeType" class="Trigger" data-nullable="(all)" />
            </label>
            <label class="Controls2-1">
                <span>Prototype / version</span>
                <i class="Icon fal fa-file-invoice" />
                <select name="prototype" class="Trigger" data-nullable="(all)" />
                <i class="Icon fal fa-list-ol" />
                <select name="version" class="Trigger" data-nullable="(all)" />
            </label>
        </form>
    </div>
    <div class="ShadowPanel Hidden" id="Result">
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new instances.LifeCycle("form#Filters", "Result");
        callback.call();
    };
</script>
