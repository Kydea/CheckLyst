<div id="InfrastructurePage">
    <h1>Prototype Types List</h1>

    <div class="ActionBar"></div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Infrastructure/PrototypeTypes">
            <label>
                <span>Department</span>
                <i class="Icon fal fa-industry" />
                <select name="department" />
            </label>
            <label>
                <span>Prototype type name</span>
                <i class="Icon fal fa-folder" />
                <input type="text" name="name" />
            </label>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>Prototype type ID</th>
                    <th>Prototype type name</th>
                    <th>Approval workflow</th>
                    <th>Obsolescence workflow</th>
                    <th>Created by</th>
                    <th>Created on</th>
                    <th>Modified by</th>
                    <th>Modified on</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="name"></td>
                    <td data-column="approvationWorkFlowDescription"></td>
                    <td data-column="obsolescenceWorkFlowDescription"></td>
                    <td data-column="createdBy"></td>
                    <td data-column="createdOn" data-type="DateTimeOffset"></td>
                    <td data-column="modifiedBy"></td>
                    <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.SearchPage({
            pageName: "PrototypeTypes",
            detailUrl: "@Url.Action("PrototypeTypesDetail")",
            filterFormSelector: "form#Filters",
            resultGridSelector: "div#Content table.Grid",
            bindEvent: "Bind",
            breadCrumbs: [
                { content: "protype types" }
            ]
        });

        callback.call();
    };
</script>