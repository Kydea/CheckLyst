<div id="UsersDetailPage">
    <h2>Prototype type</h2>

    <form id="Detail" action="@BaseUrl/Infrastructure/PrototypeTypes">
        <label>
            ID
            <i class="fi flaticon-key-o" />
            <input type="text" name="id" readonly="readonly" placeholder="(new record)" />
        </label>

        <label>
            Name
            <i class="fi flaticon-id-card-o" />
            <input type="text" name="name" />
        </label>

        <label class="Clearing">
            <input type="hidden" name="department" />
            Department
            <i class="fi flaticon-building-o" data-nullable="true" />
            <input type="text" name="departmentName" readonly="readonly" />
        </label>

        <label class="Clearing">
            Approvation work flow
            <i class="fi flaticon-workflow" />
            <select type="text" name="approvationWorkFlow" data-nullable="true" />
        </label>

        <label>
            Obslolescence work flow
            <i class="fi flaticon-workflow" />
            <select type="text" name="obsolescenceWorkFlow" data-nullable="true" />
        </label>

        <label class="Clearing">
            Created by
            <i class="fi flaticon-user-o" />
            <input type="text" name="createdBy" readonly="readonly" />
        </label>

        <label>
            Created on
            <i class="fi flaticon-calendar" />
            <input type="text" name="createdOn" readonly="readonly" data-type="DateTimeOffset" />
        </label>

        <label class="Clearing">
            Modified by
            <i class="fi flaticon-user-o" />
            <input type="text" name="modifiedBy" readonly="readonly" />
        </label>

        <label>
            Modified on
            <i class="fi flaticon-calendar" />
            <input type="text" name="modifiedOn" readonly="readonly" data-type="DateTimeOffset" />
        </label>
        <div class="Clearing"></div>

    </form>
</div>

<script type="text/javascript">
    new matematici.DetailPage({
        formSelector: "form#Detail",
        initHandler: function (detailPage) {
            var
                sender = detailPage.getSender(),
                form = detailPage.getForm();

            form.handleResult(sender.getBindResult());
        },
        completeHandler: function (detailPage) {
            if (detailPage.isNew()) {
                var
                    sender = detailPage.getSender(),
                    department = $("select[name=department]", sender.getElement()),
                    element = detailPage.getElement();

                $("input[name=department]", element).val(department.val());
                $("input[name=departmentName]", element).val(department.siblings("input.AutoComplete").val());
            }
        }
    });
</script>