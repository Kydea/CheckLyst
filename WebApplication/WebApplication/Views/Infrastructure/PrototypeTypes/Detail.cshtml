<div id="UsersDetailPage">
    <h2>Prototype type</h2>

    <form id="Detail" action="@BaseUrl/Infrastructure/PrototypeTypes">
        <input type="hidden" name="reason" />
        <label>
            <span>ID</span>
            <i class="Icon fal fa-key"></i>
            <input type="text" name="id" readonly="readonly" placeholder="(new record)" />
        </label>

        <label>
            <span>Name</span>
            <i class="Icon fal fa-id-card"></i>
            <input type="text" name="name" />
        </label>

        <input type="hidden" name="department" />
        <label class="Clearing">
            <span>Department</span>
            <i class="Icon fal fa-industry" data-nullable="-"></i>
            <input type="text" name="departmentName" readonly="readonly" />
        </label>

        <label class="Clearing">
            <span>Life cycle</span>
            <i class="Icon fal fa-clock" data-nullable="-"></i>
            <input type="text" name="lifeCycle" class="mask-pint" maxlength="4" />
        </label>

        <label class="Clearing">
            <span>Approval workflow</span>
            <i class="Icon fal fa-file-certificate"></i>
            <select type="text" name="approvationWorkFlow" data-nullable=""></select>
        </label>

        <label>
            <span>Obsolescence workflow</span>
            <i class="Icon fal fa-file-certificate"></i>
            <select type="text" name="obsolescenceWorkFlow" data-nullable=""></select>
        </label>

        <label>
            <span>Prototypes FTP server</span>
            <i class="Icon fal fa-file-export"></i>
            <select type="text" name="prototypesFTPServer" data-nullable="(disabled)"></select>
        </label>

        <label>
            <span>Instances FTP server</span>
            <i class="Icon fal fa-file-export"></i>
            <select type="text" name="instancesFTPServer" data-nullable="(disabled)"></select>
        </label>

        <label class="Clearing Controls2">
            <span>Creation</span>
            <i class="Icon fal fa-user"></i>
            <input type="text" name="createdBy" readonly="readonly" />
            <i class="Icon fal fa-calendar-alt"></i>
            <input type="text" name="createdOn" readonly="readonly" data-type="DateTimeOffset" />
        </label>

        <label class="Clearing Controls2">
            <span>Last edit</span>
            <i class="Icon fal fa-user"></i>
            <input type="text" name="modifiedBy" readonly="readonly" />
            <i class="Icon fal fa-calendar-alt"></i>
            <input type="text" name="modifiedOn" readonly="readonly" data-type="DateTimeOffset" />
        </label>

        <div class="Clearing"></div>

    </form>
</div>

<script type="text/javascript">
    new matematici.DetailPage({
        formSelector: "form#Detail",
        initHandler: function (detailPage) {
            var
                sender = detailPage.getSender(),
                form = detailPage.getForm(),
                autoCompleteOptions = sender.getBindResult();

            if (autoCompleteOptions.fields && autoCompleteOptions.fields.name) delete autoCompleteOptions.fields.name;
            if (autoCompleteOptions.fields && autoCompleteOptions.fields.department) delete autoCompleteOptions.fields.department;
            form.handleResult(autoCompleteOptions);
        },

        completeHandler: function (detailPage) {
            if (detailPage.isNew()) {
                var
                    sender = detailPage.getSender(),
                    department = $("select[name=department]", sender.getElement()),
                    element = detailPage.getElement();

                $("input[name=department]", element).val(department.val());
                $("input[name=departmentName]", element).val(department.siblings("input.AutoComplete").val());
            }
        }
    });
</script>