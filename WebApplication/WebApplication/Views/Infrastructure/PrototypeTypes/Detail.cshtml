<div id="UsersDetailPage" style="width: 300px">
    <h2>Prototype type</h2>

    <form id="Detail">
        <div class="Triggers">
            <label>
                User code
                <input type="text" name="code" />
            </label>

            <label>
                Name and surname
                <input type="text" name="description" />
            </label>

            <label>
                Authentication code
                <input type="text" name="authenticationCode" />
            </label>

            <label>
                Email
                <input type="text" name="emaik" />
            </label>

            <label>
                Enabled
                <input type="checkbox" name="enabled" />
            </label>
        </div>
    </form>

    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    var data = matematici.dialog.getData();

    matematici.dialog.setButtons([
        { cancelButton: true, hidden: true },
        { text: "save", icon: "save", id: "SaveButton", handler: function () { alert("OK"); return true; } }
    ]);

    matematici.dialog.setWidth($("#UsersDetailPage").width());

    new matematici.Form("form#Detail", {
        applyButton: "#SaveButton",
        ssbindEvent: "Bind"
    });
</script>