<div id="InfrastructurePage">
    <h1>Companies List</h1>

    <div class="ActionBar"></div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Infrastructure/Companies">
            <label>
                <span>Company</span>
                <i class="Icon fal fa-industry"></i>
                <input type="text" name="name" />
            </label>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Time zone</th>
                    <th>Online</th>
                    <th>Created by</th>
                    <th>Created on</th>
                    <th>Modified by</th>
                    <th>Modified on</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="name"></td>
                    <td data-column="timeZone"></td>
                    <td data-column="online" data-type="Boolean"></td>
                    <td data-column="createdBy"></td>
                    <td data-column="createdOn" data-type="DateTimeOffset"></td>
                    <td data-column="modifiedBy"></td>
                    <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.SearchPage({
            pageName: "Companies",
            detailUrl: "@Url.Action("CompaniesDetail")",
            filterFormSelector: "form#Filters",
            resultGridSelector: "div#Content table.Grid",
            bindEvent: "Bind",
            readOnly: matematici.tokenManager.getCompany() > 1, 
            breadCrumbs: [
                { content: "companies" }
            ]
        });

        callback.call();
    };
</script>
