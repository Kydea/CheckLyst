<div id="UsersDetailPage" style="width: 450px">
    <h2>Department</h2>

    <form id="Detail">
        <div class="Triggers">
            <label>
                ID
                <input type="text" name="id" readonly="readonly" />
            </label>

            <label>
                Name
                <input type="text" name="name" />
            </label>

            <label class="Clearing">
                Created by
                <input type="text" name="createdBy" readonly="readonly" />
            </label>

            <label>
                Created on
                <input type="text" name="createdOn" readonly="readonly" />
            </label>

            <label>
                Modified by
                <input type="text" name="modifiedBy" readonly="readonly" />
            </label>

            <label>
                Modified on
                <input type="text" name="modifiedOn" readonly="readonly" />
            </label>
        </div>
    </form>

    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    var data = matematici.dialog.getData();

    matematici.dialog.setButtons([
        { cancelButton: true, hidden: true },
        { text: "save", icon: "save", id: "SaveButton", handler: function () { alert("OK"); return true; } }
    ]);

    matematici.dialog.setWidth($("#UsersDetailPage").width());

    new matematici.Form("form#Detail", {
        applyButton: "#SaveButton",
        bindEvent: "Bind"
    });
    console.log(data);
</script>