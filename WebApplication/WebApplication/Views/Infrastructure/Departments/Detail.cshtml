<div id="UsersDetailPage">
    <h2>Department</h2>

    <form id="Detail">
        <div class="Triggers">
            <label>
                ID
                <i class="fi flaticon-departments" />
                <input type="text" name="id" readonly="readonly" />
            </label>

            <label>
                Name
                <i class="fi flaticon-data" />
                <input type="text" name="name" />
            </label>

            <label class="Clearing">
                Created by
                <i class="fi flaticon-people" />
                <input type="text" name="createdBy" readonly="readonly" />
            </label>

            <label>
                Created on
                <input type="text" name="createdOn" readonlya="readonly" class="DatePicker" />
            </label>

            <label class="Clearing">
                Modified by
                <i class="fi flaticon-people" />
                <input type="text" name="modifiedBy" readonly="readonly" />
            </label>

            <label>
                Modified on
                <input type="text" name="modifiedOn" readonly="readonly" class="DatePicker" />
            </label>
        </div>
    </form>

    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    var data = matematici.dialog.getData();

    matematici.dialog.setButtons([
        { cancelButton: true, hidden: true },
        { text: "save", icon: "save", id: "SaveButton", handler: function () { alert("OK"); return true; } }
    ]);

    matematici.dialog.setWidth(420);

    var form = new matematici.Form("form#Detail", {
        applyButton: "#SaveButton"
    });
    form.initialize();
    form.setValues(data);
</script>