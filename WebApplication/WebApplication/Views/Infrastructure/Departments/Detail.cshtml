<div id="UsersDetailPage">
    <h2>Department</h2>

    <form id="Detail" action="@BaseUrl/Infrastructure/Departments">
        <div class="Triggers">
            <label>
                ID
                <i class="fi flaticon-departments" />
                <input type="text" name="id" readonly="readonly" placeholder="(new record)" />
            </label>

            <label>
                Name
                <i class="fi flaticon-data" />
                <input type="text" name="name" />
            </label>

            <label class="Clearing">
                Created by
                <i class="fi flaticon-people" />
                <input type="text" name="createdBy" readonly="readonly" />
            </label>

            <label>
                Created on
                <input type="text" name="createdOn" readonly="readonly" data-type="DateTimeOffset" />
            </label>

            <label class="Clearing">
                Modified by
                <i class="fi flaticon-people" />
                <input type="text" name="modifiedBy" readonly="readonly" />
            </label>

            <label>
                Modified on
                <input type="text" name="modifiedOn" readonly="readonly" data-type="DateTimeOffset" />
            </label>
        </div>
    </form>

    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    var
        data = matematici.dialog.getData(),
        sender = matematici.dialog.getSender(),
        buttons = [],

        clickHandler = function (event) {
            form.trigger(event, function (result) {
                form.handleResult(result);
                if (result.valid) {
                    matematici.dialog.getResult().saved = true;
                    matematici.dialog.close();
                }
            });
        };

    buttons.push({ cancelButton: true, hidden: true });
    if (data != null)
        buttons.push({
            text: "delete", icon: "delete", handler: function () {
                clickHandler("Delete");
                return true;
            }
        });
    buttons.push({
        text: "save", icon: "save", id: "SaveButton", handler: function() {
            clickHandler(data == null ? "Add" : "Edit");
            return true;
        }
    });

    matematici.dialog.setButtons(buttons);

    matematici.dialog.setWidth(420);

    var form = new matematici.Form("form#Detail", {
        applyButton: "#SaveButton"
    });
    form.initialize();
    if (data != null) form.setValues(data);
</script>