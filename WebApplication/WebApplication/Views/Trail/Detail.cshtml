<div id="TrailDetailPage">
    <h2>Record</h2>

    <form id="Detail">
        <div class="Triggers">
            <label>
                ID
                <i class="fi flaticon-building-o" />
                <input type="text" name="id" readonly="readonly" />
            </label>

            <label>
                Date
                <i class="fi flaticon-calendar" />
                <input type="text" name="date" readonly="readonly" data-type="DateTimeOffset" />
            </label>

            <label class="Clearing">
                User
                <i class="fi flaticon-user-o" />
                <input type="text" name="user" readonly="readonly" />
            </label>

            <label>
                Action
                <i class="fi flaticon-cog" />
                <input type="text" name="action" readonly="readonly" />
            </label>

            <label class="Clearing FullWidth">
                Checklist code
                <i class="fi flaticon-instance" />
                <input type="text" name="checklist" readonly="readonly" />
            </label>

            <label class="Clearing FullWidth">
                Detail
                <textarea type="text" name="information" readonly="readonly" />
            </label>
        </div>
    </form>

    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    new matematici.DetailPage({
        formSelector: "form#Detail",
        readOnly: true
    });
</script>