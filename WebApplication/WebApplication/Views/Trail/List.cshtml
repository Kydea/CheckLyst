<div id="AuditTrailPage">
    <h1>Audit Trail</h1>

    <div class="ActionBar"></div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Trail/List">
            <label>
                From
                <input type="text" name="from" class="DatePicker" />
            </label>
            <label>
                To
                <input type="text" name="to" class="DatePicker" />
            </label>
            <label>
                User
                <i class="fi flaticon-user-o" />
                <input type="text" name="user" />
            </label>
            <label>
                Action
                <i class="fi flaticon-cog" />
                <input type="text" name="action" />
            </label>
            <label>
                CheckList code
                <i class="fi flaticon-instance" />
                <input type="text" name="checklist" />
            </label>
            <label>
                Detail
                <i class="fi flaticon-align-left" />
                <input type="text" name="information" />
            </label>

            <a id="ApplyButton" class="Button DefaultButton"><i class="fa fa-search"></i> search</a>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>CheckList Code</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="date" data-type="DateTimeOffset"></td>
                    <td data-column="user"></td>
                    <td data-column="action"></td>
                    <td data-column="checklist"></td>
                    <td data-column="information"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.SearchPage({
            pageName: "AuditTrail",
            detailUrl: "@Url.Action("Detail")",
            filterFormSelector: "form#Filters",
            resultGridSelector: "div#Content table.Grid",
            breadCrumbs: [
                { content: "audit trail" }
            ],
            readOnly: true
        });

        callback.call();
    };
</script>