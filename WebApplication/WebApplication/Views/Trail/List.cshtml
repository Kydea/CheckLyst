<div id="AuditTrailPage">
    <h1>Audit Trail</h1>

    <div class="ActionBar">
        <a id="ExportButton" class="Button" href="#">Export<i class="Icon fa fa-caret-down"></i></a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Trail/List">
            <label class="Controls2">
                <span>Date range</span>
                <input type="text" name="from" class="DatePicker" />
                <input type="text" name="to" class="DatePicker" />
            </label>
            <label class="Clearing">
                <span>Logged user code</span>
                <i class="Icon fal fa-user"></i>
                <input type="text" name="user" />
            </label>
            <label>
                <span>Action</span>
                <i class="Icon fal fa-cogs"></i>
                <select name="action" data-nullable="-" data-free="true">
                    <option value="Email failed">Email failed</option>
                    <option value="Email sent">Email sent</option>
                    <option value="Login">Login</option>
                    <option value="Logout">Logout</option>
                    <option value="Login failed">Login failed</option>
                    <option value="User created">User created</option>
                    <option value="User edited">User edited</option>
                    <option value="User deleted">User deleted</option>
                    <option value="User banned">User banned</option>
                    <option value="User disabled">User disabled</option>
                    <option value="PIN banned">PIN banned</option>
                    <option value="PIN disabled">PIN disabled</option>
                    <option value="Group created">Group created</option>
                    <option value="Group edited">Group edited</option>
                    <option value="Group deleted">Group deleted</option>
                    <option value="Role created">Role created</option>
                    <option value="Role edited">Role edited</option>
                    <option value="Role deleted">Role deleted</option>
                    <option value="Prototype created">Prototype created</option>
                    <option value="Prototype deleted">Prototype deleted</option>
                    <option value="Prototype state auto-changed">Prototype state auto-changed</option>
                    <option value="Prototype state changed">Prototype state changed</option>
                    <option value="Prototype state change proposed">Prototype state change proposed</option>
                    <option value="Prototype signature issued">Prototype signature issued</option>
                    <option value="Prototype export completed">Prototype export completed</option>
                    <option value="Prototype export failed">Prototype export failed</option>
                    <option value="Prototype changed">Prototype changed</option>
                    <option value="Instance created">Instance created</option>
                    <option value="Instance opened">Instance opened</option>
                    <option value="Instance quitted">Instance quitted</option>
                    <option value="Instance state changed">Instance state changed</option>
                    <option value="Instance signature issued">Instance signature issued</option>
                    <option value="Instance signature failed">Instance signature failed</option>
                    <option value="Instance signature canceled">Instance signature canceled</option>
                    <option value="Instance signature cancelation failed">Instance signature cancelation failed</option>
                    <option value="Instance export completed">Instance export completed</option>
                    <option value="Instance export failed">Instance export failed</option>
                    <option value="Instance value changed">Instance value changed</option>
                    <option value="Instance value copied">Instance value copied</option>
                    <option value="Instance iteration added">Instance iteration added</option>
                    <option value="Instance iteration deleted">Instance iteration deleted</option>
                    <option value="Instance iteration moved up">Instance iteration moved up</option>
                    <option value="Instance iteration moved down">Instance iteration moved down</option>
                    <option value="Instance external source row changed">Instance external source row changed</option>
                    <option value="Instance external source row imported">Instance external source row imported</option>
                    <option value="Instance downloaded">Instance downloaded</option>
                    <option value="Job error">Job error</option>
                    <option value="Workflow signature issued">Workflow signature issued</option>
                    <option value="Workflow signature failed">Workflow signature failed</option>
                    <option value="Workflow created">Workflow created</option>
                    <option value="Workflow updated">Workflow updated</option>
                    <option value="Workflow deleted">Workflow deleted</option>
                    <option value="DataSource created">DataSource created</option>
                    <option value="DataSource updated">DataSource updated</option>
                    <option value="DataSource deleted">DataSource deleted</option>
                    <option value="Company created">Company created</option>
                    <option value="Company updated">Company updated</option>
                    <option value="Department created">Department created</option>
                    <option value="Department updated">Department updated</option>
                    <option value="Department deleted">Department deleted</option>
                    <option value="PrototypeType created">PrototypeType created</option>
                    <option value="PrototypeType updated">PrototypeType updated</option>
                    <option value="PrototypeType deleted">PrototypeType deleted</option>
                    <option value="Prototype downloaded">Prototype downloaded</option>
                    <option value="FTPServer created">FTPServer created</option>
                    <option value="FTPServer updated">FTPServer updated</option>
                    <option value="FTPServer deleted">FTPServer deleted</option>
                    <option value="Report created">Report created</option>
                    <option value="Report updated">Report updated</option>
                    <option value="Report deleted">Report deleted</option>
                </select>
            </label>
            <label>
                <span>CheckList code</span>
                <i class="Icon fal fa-layer-group"></i>
                <input type="text" name="checkListCode" />
            </label>
            <label>
                <span>CheckList ID</span>
                <i class="Icon fal fa-layer-group"></i>
                <input type="text" name="checkListID" />
            </label>
            <label>
                <span>Detail</span>
                <i class="Icon fal fa-align-left"></i>
                <input type="text" name="information" />
            </label>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Logged user code</th>
                    <th>Action</th>
                    <th>CheckList code</th>
                    <th>CheckList ID</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="date" data-type="DateTimeOffset"></td>
                    <td data-column="user"></td>
                    <td data-column="action"></td>
                    <td data-column="checkListCode"></td>
                    <td data-column="checkListID"></td>
                    <td data-column="shortInformation"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var searchPage = new matematici.SearchPage({
            pageName: "Trail",
            detailUrl: "@Url.Action("Detail")",
            filterFormSelector: "form#Filters",
            resultGridSelector: "div#Content table.Grid",
            breadCrumbs: [
                { content: "audit trail" }
            ]
        });

        $("a#ExportButton").on("click", function () {
            var form = searchPage.getForm();
            form.trigger("Export", function (result) {
                location = form.getElement().attr("action") + "/Export?Token=" + result.token;
            })
        });

        callback.call();
    };
</script>