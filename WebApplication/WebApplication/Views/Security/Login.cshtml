@model string
@*Matematici.ViewModels.Membership.Login*@

<div class="Login">
    <div class="Box">
        <form>
            <img src="~/Content/Media/Logo.Big.png" alt="" />

            @if (Request["m"] != null)
            {
                <div class="Message">
                    Your session has expired. Please login again.
                </div>}

            <input type="hidden" name="grant_type" value="password" />
            <input type="text" name="companyId" value="2" />
            <label for="username">User code</label>
            <input type="text" name="username" />
            <label for="password">Password</label>
            <input type="password" name="password" />
            <div class="Errors">
            </div>
            <div class="Buttons Container">
                <a class="Button DefaultButton" href="#" id="Sign"><i class="fa fa-check"></i> Login</a>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript">
    matematici.isLoginPage = true;

    matematici.events.onPageLoad = function (callback) {
        matematici.clock.stop();

        var form = $("form");

		new matematici.Page({
			name: "Login",
			initializers: [ ]
		});

		new matematici.Login("div.Login", function () {
            $("div.Errors", form).hide();
            $.ajax(matematici.urls.accessControl.token, {
		        data: form.serialize(),
		        type: "post"
            }).done(function (result) {
                matematici.tokenManager.login(result);

                matematici.client.createNew(function () { matematici.navigator.open("@Model"); });
                //matematici.clock.resume();
            }).fail(function (jqXhr, textStatus, errorThrown) {
                $("div.Errors", form).html(jqXhr.responseJSON && jqXhr.responseJSON.error_description || errorThrown).show();
                console.log(jqXhr, textStatus, errorThrown);
            });
        });
        matematici.loader.checkInitialCurtain();
        callback.call();
    };

    matematici.events.onPageUnload = function (callback) {
        matematici.isLoginPage = false;
        callback.call();
    }
</script>