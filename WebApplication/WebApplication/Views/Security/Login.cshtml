@model string
@*Matematici.ViewModels.Membership.Login*@

<div class="Login">
    <div class="Box AutoCenter">
        <form>
            @if (Request["m"] != null)
            {
                <div class="Message">
                    Your session has expired. Please login again.
                </div>
            }

            <input type="hidden" name="grant_type" value="password" />

            <label class="FullWidth">
                <span>Company</span>
                <i class="Icon fi flaticon-buildings-o"></i>
                <select name="companyId"></select>
            </label>
            
            <label class="FullWidth Controls2">
                <span>User code / Password</span>
                <i class="Icon fi flaticon-user-o"></i>
                <input type="text" name="username" placeholder="username" />
                <i class="Icon fi flaticon-key-o"></i>
                <input type="password" name="password" placeholder="password" />
            </label>

            <div class="Errors"></div>

            <div class="Buttons">
                <a class="Button DefaultButton GreyGreenButton" href="#" id="Sign"><i class="fi flaticon-arrow-right"></i>LOGIN</a>
            </div>
        </form>
    </div>
    <div class="Version">Version: @CheckListManager.WebApplication.Code.Version.Get()</div>
</div>

<script type="text/javascript">
    matematici.isLoginPage = true;

    matematici.events.onPageLoad = function (callback) {
        matematici.clock.stop();

        var
            form = $("form"),
            error = $("div.Errors", form),
            companyList = $("select[name=companyId]", form),
            userCode = $("input[name=username]", form),
            password = $("input[name=password]", form),

            showError = function (message) {
                error.html(" " + message).prepend($("<i />").addClass("fi flaticon-warning")).show()
            };

        new matematici.Page({
            name: "Login",
            initializers: []
        });

        new matematici.Login("div.Login", function () {
            error.empty().hide();
            if (companyList.val() == null)
                showError("select a company");
            else if (userCode.val() == "")
                showError("select a user code");
            else if (password.val() == "")
                showError("select a password");
            else
                $.ajax(matematici.urls.accessControl.token, {
                    data: form.serialize(),
                    type: "post",
                    suppressErrors: true
                }).done(function (result) {
                    localStorage.companyName = companyList.data("autoComplete").getControl().val();
                    matematici.tokenManager.login(result);
                    matematici.clock.refresh();
                    //matematici.clock.resume();
                    matematici.navigator.open("@Model")
                }).fail(function (jqXhr, textStatus, errorThrown) {
                    showError(jqXhr.responseJSON && jqXhr.responseJSON.error_description || errorThrown);
                    console.log(jqXhr, textStatus, errorThrown);
                });
        });

        matematici.tokenManager.logout();
        matematici.loader.checkInitialCurtain();

        //load the companies
        $.ajax(matematici.urls.infrastructure.companies.getData, {
            type: "post"
        }).done(function (result) {
            for (var index in result) {
                var company = result[index];
                companyList.append($("<option />").attr("value", company.id).text(company.name));
            }
            companyList.val(null);
            callback.call();
        }).fail(function (jqXhr, textStatus, errorThrown) {
            showError(jqXhr.responseJSON && jqXhr.responseJSON.error_description || errorThrown);
            console.log(jqXhr, textStatus, errorThrown);
        });
    };

    matematici.events.onPageUnload = function (callback) {
        matematici.isLoginPage = false;
        callback.call();
    }
</script>