@model string
@*Matematici.ViewModels.Membership.Login*@

<div class="Login">
    <div class="Box AutoCenter">
        <form>
            @if (Request["m"] != null)
            {
                <div class="Message">
                    Your session has expired. Please login again.
                </div>
            }

            <input type="hidden" name="grant_type" value="password" />

            <label class="FullWidth">
                <span>Company</span>
                <i class="Icon fal fa-industry"></i>
                <select name="companyId"></select>
            </label>
            
            <label class="FullWidth Controls2">
                <span>User code / Password</span>
                <i class="Icon fal fa-user"></i>
                <input type="text" name="username" placeholder="username" />
                <i class="Icon fal fa-key"></i>
                <input type="password" name="password" placeholder="password" />
            </label>
                
            <div class="Errors"></div>

            <div class="Buttons">
                <a class="Button DefaultButton GreyGreenButton" href="#" id="Sign"><i class="Icon fas fa-chevron-circle-right"></i>LOGIN</a>
            </div>
        </form>
    </div>
    <div class="Version">Version: @CheckListManager.WebApplication.Code.Version.Get()</div>
</div>

<script type="text/javascript">
    matematici.isLoginPage = true;

    matematici.events.onPageLoad = function (callback) {
        matematici.clock.stop();

        var
            form = $("form"),
            error = $("div.Errors", form),
            companyList = $("select[name=companyId]", form),
            userCode = $("input[name=username]", form),
            password = $("input[name=password]", form),
            companies = {},
            redirectUrl = localStorage.redirectUrl && localStorage.redirectUrl.indexOf("/Security/Login") < 0 ? localStorage.redirectUrl : null,

            showError = function (message) {
                error.html(" " + message).prepend($("<i />").addClass("fas fa-exclamation-triangle")).show()
            };

        new matematici.Page({
            name: "Login",
            initializers: []
        });

        new matematici.Login("div.Login", function () {
            error.empty().hide();
            if (companyList.val() == null)
                showError("select a company");
            else if (userCode.val() == "")
                showError("select a user code");
            else if (password.val() == "")
                showError("select a password");
            else
                $.ajax(matematici.urls.accessControl.token, {
                    data: form.serialize(),
                    type: "post",
                    suppressErrors: true
                }).done(function (result) {
                    localStorage.companyName = companyList.data("autoComplete").getControl().val();
                    var company = companyList.data("autoComplete").getValue();
                    localStorage.inactivityTimeoutSeconds = companies[company].inactivityTimeoutSeconds;
                    matematici.tokenManager.login(result);
                    matematici.clock.resume();
                    localStorage.removeItem("redirectUrl");
                    matematici.navigator.open(redirectUrl || matematici.urls.dashboard);
                }).fail(function (jqXhr, textStatus, errorThrown) {
                    showError(jqXhr.responseJSON && jqXhr.responseJSON.error_description || jqXhr.responseJSON && jqXhr.responseJSON.messages && jqXhr.responseJSON.messages.join(' ') || errorThrown);
                });
        });

        matematici.tokenManager.logout();

        //closes all possibile pending light boxes
        matematici.popup.close();
        matematici.dialog.close();
        matematici.elements.body.removeClass("CheckListGrid");
        matematici.elements.body.children("div.CheckListGrid").remove();

        matematici.loader.checkInitialCurtain();

        //load the companies
        $.ajax(matematici.urls.infrastructure.companies.getData, {
            type: "post",
            suppressErrors: true
        }).done(function (result) {
            for (var index in result) {
                var company = result[index];
                companies[company.id] = company;
                companyList.append($("<option />").attr("value", company.id).data("inactivityTimeoutSeconds", company.inactivityTimeoutSeconds).text(company.name));
            }
            companyList.val(null);
            callback.call();
        }).fail(function (jqXhr, textStatus, errorThrown) {
            showError(jqXhr.responseJSON && jqXhr.responseJSON && jqXhr.responseJSON.messages && jqXhr.responseJSON.messages.join(' ') || errorThrown);
        });
    };

    matematici.events.onPageUnload = function (callback) {
        matematici.isLoginPage = false;
        callback.call();
    }
</script>