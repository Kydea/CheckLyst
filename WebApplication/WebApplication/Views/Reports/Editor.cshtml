@model CheckListManager.WebApplication.Models.Report

<div id="ReportsDetailPage" class="Report">
    <h1>Report editor</h1>

    <div class="ActionBar">
        <span class="ButtonGroup" data-text="Actions"></span>
    </div>

    <div class="ShadowPanel">
        <h2 class="Green">(New report)</h2>

        <form id="Detail" action="@BaseUrl/Reports/List">
            <input type="hidden" name="reason" />
            <input type="hidden" name="id" />
            <div class="TabContainer">
                <div class="TabLabels">
                    <a href="#">Details</a>
                    <a href="#">Note</a>
                </div>
                <div class="Tab">
                    <input type="hidden" name="newVersion" />
                    <label class="Controls2">
                        <span>Code</span>
                        <i class="Icon fal fa-key"></i>
                        <input type="text" name="code" autocomplete="off" maxlength="50" />
                        <i class="Icon fa fa-sort-numeric-down"></i>
                        <input type="text" name="version" autocomplete="off" maxlength="50" />
                    </label>

                    <label>
                        <span>Source</span>
                        <i class="Icon fal fa-chart-network"></i>
                        <select name="reportSource" data-nullable="(custom)"></select>
                    </label>

                    <label>
                        <span>State</span>
                        <i class="Icon fal fa-tasks"></i>
                        <input type="text" name="reportState" />
                    </label>

                    <label>
                        <span>Workflow</span>
                        <i class="Icon fal fa-file-certificate"></i>
                        <select name="workFlow" data-nullable="" class="ReadOnly"></select>
                    </label>

                    <label class="Clearing FullWidth">
                        <span>Description</span>
                        <i class="Icon fal fa-align-left"></i>
                        <input type="text" name="description" autocomplete="off" maxlength="100" />
                    </label>

                    @*
                        <label class="Clearing">
                            <span>Instances range restricted</span>
                            <input type="checkbox" name="instancesRangeRestricted" />
                        </label>

                        <label>
                            <span>Instances ID alias</span>
                            <i class="Icon fal fa-layer-group"></i>
                            <input type="text" name="instancesIDAlias" />
                        </label>

                        <label class="Clearing">
                            <span>Prototypes range restricted</span>
                            <input type="checkbox" name="prototypesRangeRestricted" />
                        </label>

                        <label>
                            <span>Prototypes ID alias</span>
                            <i class="Icon fal fa-file-invoice"></i>
                            <input type="text" name="prototypesIDAlias" />
                        </label>
                    *@

                    <label class="FullWidth">
                        <span>Query</span>
                        <pre id="AceEditor" style="height: 350px"></pre>
                    </label>

                    <label class="Clearing Controls2">
                        <span>Proposed state</span>
                        <i class="Icon fal fa-tasks"></i>
                        <input type="text" name="proposedState" readonly="readonly" />
                        <i class="Icon fal fa-calendar-alt"></i>
                        <input type="text" name="proposedDate" readonly="readonly" data-type="DateTimeOffset" />
                    </label>

                    <label class="Clearing Controls2">
                        <span>Creation</span>
                        <i class="Icon fal fa-user"></i>
                        <input type="text" name="createdBy" readonly="readonly" />
                        <i class="Icon fal fa-calendar-alt"></i>
                        <input type="text" name="createdOn" readonly="readonly" data-type="DateTimeOffset" />
                    </label>

                    <label class="Controls2">
                        <span>Last edit</span>
                        <i class="Icon fal fa-user"></i>
                        <input type="text" name="modifiedBy" readonly="readonly" />
                        <i class="Icon fal fa-calendar-alt"></i>
                        <input type="text" name="modifiedOn" readonly="readonly" data-type="DateTimeOffset" />
                    </label>
                </div>
                <div class="Tab Note">
                    <div class="Clearing"></div>

                    <label class="FullWidth">
                        <textarea name="note"></textarea>
                    </label>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var
            selector = "#ReportsDetailPage",
            element = $(selector),

            actionButtonsGroup = new matematici.ButtonGroup("span.ButtonGroup"),

            reportEditor = new reports.ReportEditor(element, {
                id: @(Model.ID ?? -1),
                listUrl: "@Url.Action("List")",
                detailUrl: "/Reports/Editor/",
                viewerUrl: "@Url.Action("Viewer")",
                actionButtonsGroup: actionButtonsGroup,
                newVersion: @(Model.NewVersion ? "true" : "false")
            }),

            actionBar = new matematici.ActionBar("div.ActionBar")
                .add("<i class='Icon fa fa-users'></i>", function () {
                    reportEditor.showGroups();
                }, "Icon GroupsButton")
                .add("<i class='Icon fa fa-filter'></i>", function () {
                    reportEditor.showClauses();
                }, "Icon ClausesButton")
                .add("<i class='Icon fa fa-line-columns'></i>", function () {
                    reportEditor.showColumns();
                }, "Icon ColumnsButton");

        actionButtonsGroup
            .add("Quit", function () {
                reportEditor.quit();
            }, "Quit")
            .add("Delete", function () {
                reportEditor.deleteRecord();
            }, "Delete")
            .add("Save", function () {
                reportEditor.save();
            }, "Save")
            .add("View", function () {
                reportEditor.view();
            }, "View")
            .add("Submit for obsol.", function () {
                reportEditor.setState(reports.Report.states.obsolete);
            }, "SubmitForObsolescence")
            .add("Obsolete", function () {
                reportEditor.loadSignatureBook();
            }, "Obsolete")
            .add("Confirm", function () {
                reportEditor.loadSignatureBook();
            }, "Confirm")
            .add("Complete", function () {
                reportEditor.setState(reports.Report.states.completed);
            }, "Complete")
            .add("Verify", function () {
                reportEditor.verify(false);
            }, "Verify");

        new matematici.Page({
            name: "ReportEditor",
            cssClass: "ReportEditor",
            breadcrumbs: [
                { content: "report editor" }
            ]
        });

        new matematici.Tab(selector + " div.TabContainer", {
            fixedHeight: true
        });

        matematici.save = reportEditor.save;

        matematici.events.onPageUnload = function (callback) {
            reports.reportEditor = null;
            matematici.canClose = true;
            matematici.save = undefined;
            callback();
        };

        callback.call();
    }
</script>