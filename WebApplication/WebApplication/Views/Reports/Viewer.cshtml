@model CheckListManager.WebApplication.Models.Report

<div id="ReportViewerPage" class="Report">
    <h1>Report viewer</h1>

    <div class="ActionBar">
        <span class="ButtonGroup" data-text="Actions"></span>
    </div>

    <div class="ShadowPanel">
        <h2 class="Green"></h2>

        <form id="Detail" action="@BaseUrl/Reports/List">
            <input type="hidden" name="id" />
            <input type="hidden" name="code" />
        </form>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var
            element = $("#ReportViewerPage"),
            reportViewer = new reports.ReportViewer(element, {
                id: @(Model.ID.Value),
                reportUrl: "@Url.Action("Report")",
                editorUrl: "@Url.Action("Editor")",
                listUrl: "@Url.Action("List")",
            }),

            actionBar = new matematici.ActionBar("div.ActionBar"),

            buttonGroup = new matematici.ButtonGroup("span.ButtonGroup")
                .add("Quit", function () {
                    reportViewer.quit();
                }, "Quit")
                .add("Run", function () {
                    reportViewer.run();
                }, "Run");

        if (matematici.tokenManager.checkRole("Reports#Edit#"))
            buttonGroup.add("Query", function () {
                reportViewer.query();
            }, "Query")

        new matematici.Page({
            name: "ReportViewer",
            cssClass: "ReportViewer",
            breadcrumbs: [
                { content: "report viewer" }
            ]
        });

        matematici.events.onPageUnload = function (callback) {
            reports.reportViewer = null;
            callback();
        };

        callback.call();
    }
</script>