<div id="ColumnEditor">
    <h2>Column Editor</h2>

    <form id="Detail">
        <label class="Clearing Width300">
            <span>Label</span>
            <input type="text" name="label" autocomplete="off" maxlength="50" />
        </label>

        <label class="Clearing Width300">
            <span>Format</span>
            <input type="text" name="format" autocomplete="off" maxlength="50" />
        </label>

        <label class="Clearing">
            <span>Visible</span>
            <input type="checkbox" name="visible" />
        </label>

        <label class="Clearing Width300">
            <span>Behaviour</span>
            <select id="Behaviour" data-nullable="(simple column)">
                <option value="u">order by this column ascending</option>
                <option value="d">order by this column descending</option>
                <option value="ug">group and order by this column ascending</option>
                <option value="dg">group and order by this column descending</option>
            </select>
        </label>

        <label class="Clearing Width300">
            <span>Aggregation</span>
            <select name="groupAggregation" data-nullable="(hidden in the total rows)">
                <option value="sum">sum</option>
                <option value="average">average</option>
                <option value="count">count</option>
                <option value="min">min</option>
                <option value="max">max</option>
                <option value="first">first</option>
                <option value="first">last</option>
            </select>
        </label>

        <label class="Clearing Width300">
            <span>Column</span>
            <pre id="ColumnAceEditor" style="height: 100px"></pre>
        </label>
    </form>
</div>

<script type="text/javascript">
    var
        columnEditor = matematici.popup.getData(),
        form = $("div#ColumnEditor form#Detail");

    columnEditor.fill(form);
</script>