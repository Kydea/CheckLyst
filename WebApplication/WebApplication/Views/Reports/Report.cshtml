@model CheckListManager.WebApplication.Models.Report

<div id="Report" class="Report ShadowPanel">
    <h1 class="Green">
        <button id="ReportMenuButton" class="hamburger hamburger--spin" type="button">
            <span class="hamburger-box">
                <span class="hamburger-inner"></span>
            </span>
        </button>
    </h1>

    <table class="Grid">
        <thead></thead>
        <tbody>
            <tr class="NoRecord"><td>(no record)</td></tr>
        </tbody>
    </table>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var
            element = $("#Report");

        new matematici.Page({
            name: "Report",
            cssClass: "Report",
            breadcrumbs: [
                { content: "report" }
            ],
            initializers: [
                new reports.Report("#Report", { id: @Model.ID })
            ]
        });

        callback.call();
    }
</script>