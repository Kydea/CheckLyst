<script type="text/javascript">
    var lastError;

    function copyError() {
        copy(lastError);
        return "last error copied in the clipboard, you can paste it in your editor";
    };

	$.datepicker.setDefaults({ dateFormat: 'dd/mm/yy' });

    $(document)
        .ajaxStart(function () {
            matematici.loader.show();
        }).ajaxStop(function () {
            matematici.loader.hide();
        }).ajaxError(function (event, jqxhr, settings, thrownError) {
            if (!settings.accessToken && matematici.navigator.handleAjaxError(jqxhr)) {
                //alert("access denied for resource: " + (settings || { url: "(no url available)" }).url + (localStorage.accessToken == null ? " (access token was null)" : ""));
                return; //possibly redirects to login form
            }

            var
                message = "",
                data = jqxhr.responseJSON && jqxhr.responseJSON.data || "(no exception detail)";
            if (jqxhr.responseJSON && jqxhr.responseJSON.messages)
                for (var index in jqxhr.responseJSON.messages)
                    message += jqxhr.responseJSON.messages[index] + "<br />";
            else if (jqxhr.responseJSON && jqxhr.responseJSON.error_description)
                message = jqxhr.responseJSON.error_description;
            else if (thrownError)
                message = thrownError;
            else if (jqxhr.status)
                message = "HTTP error " + jqxhr.status;
            else
                message = "Unexpected error";

            lastError = { message, detail: data, extra: { event, jqxhr, settings, thrownError } };

            console.log("error", new Date(), lastError);
            console.log("you can copy last error in the clipboard with the command copyError()");
            console.log("settings", settings);

            if (!settings.suppressErrors) {
                var dialogSettings = {
                    title: "Error",
                    content: message,
                    cssClass: "Error",
                    buttons: { text: "ok", icon: "check", defaultButton: true, cancelButton: true }
                };

                if (settings.onErrorClosed)
                    dialogSettings.buttons.handler = settings.onErrorClosed;
                matematici.dialog.show(dialogSettings);
            }
            settings.errorHandler && settings.errorHandler();
        }
    );

    $.ajaxSetup({
        beforeSend: function (xhr, settings) {
            if (!settings.suppressToken) {
                var token = settings.accessToken || localStorage.accessToken;
                if (token) xhr.setRequestHeader("Authorization", "Bearer " + token);
                if (localStorage.timeZone) xhr.setRequestHeader("CompanyTimeZone", localStorage.timeZone);
            }
        }
    });


    if (Modernizr.touch) matematici.touch.init();

    matematici.appMode = "@(ViewBag.AppMode ? "1" : "0")" == "1";
    matematici.navigator.setBasePath("@Url.Content("~/")").setLastPath("@Request.RawUrl");
    matematici.navigator.checkEventHandlers();

    matematici.elements.window = $(window);
    matematici.elements.document = $(document);
    matematici.elements.body = $("body");
    matematici.elements.content = $("div#Content");
    matematici.elements.header = $("header");
    matematici.elements.menu = $("nav", matematici.elements.header);
    matematici.elements.footer = $("footer");

    matematici.clock = new matematici.Clock(matematici.isLoginPage); //@@(ViewBag.AppMode ? "true" : "matematici.isLoginPage"));

    matematici.elements.window.on("beforeunload", function () {
        if (!matematici.canClose)
            return "Warning: any unsaved change will be lost.";
    }).on("resize", function () {
        //TODO mettere in initializers e destroyers del tab
        $(".TabContainer").each(function () {
            $(this).data("tab").resize();
        });
    });

    matematici.breadcrumbs = new matematici.Breadcrumbs("div#Breadcrumbs");
    matematici.menu = new matematici.Menu("ul.Menu");
    matematici.userPanel = new matematici.UserPanel("div#UserPanel");
    matematici.autoScroller = new matematici.AutoScroller();
    matematici.help = new matematici.Help();
    matematici.tokenManager = new matematici.TokenManager();
    matematici.hamburger = new matematici.Hamburger("#MenuButton");

    matematici.navigator.handlePageLoad(null, function () { });

    matematici.clock.add("span.ServerTime");
    matematici.clock.add("span.LocalTime");

    matematici.menu.toggleItemsByRole();

    matematici.userPanel.update();
    if (matematici.tokenManager.getAccessToken())
        matematici.clock.resume();

    matematici.elements.body.on("keydown", function (e) {
        var key = e.which;
        if (key == 13 && e.target.type == "textarea") return;

        switch (key)
        {
            case 13:
            case 27:
                var
                    selector = key == 13 ? ".DefaultButton:visible" : ".CancelButton:visible",
                    container = $("div.Blip"),
                    button = $("div.Blip");

                if (container.size() == 0) {
                    container = $("div.Dialog");
                    button = $(selector, container);
                }

                if (container.size() == 0) {
                    container = $("div.Popup, div.CheckListGrid").last();
                    button = $(selector, container);
                }

                if (container.size() == 0)
                    button = $(selector);

                if (button.size() > 0) {
                    button.last().click();
                    e.preventDefault();
                }

                break;
        }
    }).on("click", "label input:not([type=checkbox]):not([type=radio])", function (e) {
        e.preventDefault(); //in ios two inputs in the same label give problems
    });
</script>