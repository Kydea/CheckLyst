@{ 
    var Security = new
    {
        CurrentUser = new { Code = HttpContext.Current.User.Identity.Name /*"Administrator"*/, SettingsManager = true, Description = HttpContext.Current.User.Identity.Name }
    };
}

<header class="Container">
    <div id="Logo" class="Padded">
        <img src="~/Content/Media/Logo.png" />
        <a href="#" id="HelpButton" title="User manual"><i class="fa fa-question"></i></a>
    </div>

    <div id="UserPanel" class="Padded Container">
        @if (Security.CurrentUser != null)
        {
            <a class="User LeftFloating CurrentUser" href="#">
                <span class="UserName" title="@Security.CurrentUser.Code" data-settingsmanager="@Security.CurrentUser.SettingsManager">@Security.CurrentUser.Description</span> <i class="fa fa-user"></i>
            </a>
        }

        @*@if (Security.Sessions != null)
        {
            foreach (var Session in Security.Sessions)
            {
                <a class="User LeftFloating" href="#">
                    <span class="UserName" title="@Session.Code" data-settingsmanager="@Security.CurrentUser.Code">@Session.Description</span> <i class="fa fa-user"></i>
                </a>
            }
        }*@

        <a id="Logout" class="Standard RightFloating" href="@Url.Action("Logout", "Security")">Logout <i class="fa fa-sign-out"></i></a>
        <a class="Add RightFloating" href="#">(add signer) <i class="fa fa-plus-circle"></i></a>
    </div>

    <a id="MenuButton" class="Mobile" href="#"><i class="fa fa-bars"></i> MENU</a>
    <nav class="Menu">
        <ul class="Menu Plain">
            <li class="MenuItem"><a class="MenuItem" href="@Url.Action("Dashboard", "Default")">Dashboard</a></li>

            @if (Security.CurrentUser != null && Security.CurrentUser.SettingsManager)
            {
                <li class="MenuItem">
                    <span class="MenuItem">Settings</span>

                    <ul class="SubMenu">
                        <li>
                            <a href="@Url.Action("List", "ProfilesEditor")">Profiles Editor</a>
                        </li>
                        <li>
                            <a href="@Url.Action("List", "PrototypeTypesEditor")">Prototype Types List</a>
                        </li>
                        <li>
                            <a href="@Url.Action("List", "AuditTrail")">Audit Trail</a>
                        </li>
                        <li>
                            <a href="@Url.Action("List", "DataSourcesManager")">Data Sources Manager</a>
                        </li>
                    </ul>
                </li>
            }
            <li class="MenuItem">
                <a href="@Url.Action("List", "PrototypesEditor")" class="MenuItem">Prototypes</a>
            </li>
            <li class="MenuItem">
                <a href="@Url.Action("List", "InstancesEditor")" class="MenuItem">Instances </a>
            </li>

            @*@{ var DataSources = Security.CurrentUser == null ? null : Matematici.Entities.DataSources.GetByUser(DbContext, Security.CurrentUser.Code); }
            @if (DataSources != null && DataSources.Count > 0)
            {
                <li class="MenuItem">
                    <a href="@Url.Action("List", "DataSourcesEditor")" class="MenuItem">Data Sources Editor</a>
                </li>
            }*@
        </ul>

    </nav>

</header>
