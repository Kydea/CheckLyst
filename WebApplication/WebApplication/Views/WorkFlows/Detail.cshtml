<div id="UsersDetailPage">
    <h2>Workflow</h2>

	<form id="Detail" action="@BaseUrl/WorkFlows/List">
		<input type="hidden" name="reason" />
		<div class="TabContainer">
			<div class="TabLabels">
				<a href="#">Details</a>
				<a href="#">Steps</a>
			</div>
			<div class="Tab">
				<label>
					<span>ID</span>
					<i class="Icon fal fa-key" />
					<input type="text" name="id" readonly="readonly" placeholder="(new record)" />
				</label>

				<label>
					<span>Description</span>
					<i class="Icon fal fa-id-card" />
					<input type="text" name="description" />
				</label>

				<label class="Clearing Controls2">
					<span>Creation</span>
					<i class="Icon fal fa-user" />
					<input type="text" name="createdBy" readonly="readonly" />
					<i class="Icon fal fa-calendar-alt" />
					<input type="text" name="createdOn" readonly="readonly" data-type="DateTimeOffset" />
				</label>

				<label class="Controls2">
					<span>Last edit</span>
					<i class="Icon fal fa-user" />
					<input type="text" name="modifiedBy" readonly="readonly" />
					<i class="Icon fal fa-calendar-alt" />
					<input type="text" name="modifiedOn" readonly="readonly" data-type="DateTimeOffset" />
				</label>

				<div class="Clearing"></div>
			</div>
			<div class="Tab" id="StepTab">
				<div class="Clearing"></div>
			</div>
		</div>
	</form>
</div>

<script type="text/javascript">
    var
        maxSteps = 3,

        formSelector = "form#Detail",

        formElement = $(formSelector),

        stepTab = $("#StepTab", formElement),

        resize = function () {
            tab.resize();
            setTimeout(function () {
                matematici.popup.center();
            }, 500);
        },

        fixSteps = function () {
            var
                steps = $("div.Step", formElement).each(function (index) {
                    var step = $(this);
                    step.children("h3").text("Step " + (index + 1));
                    $("label.Reason input", this).attr("name", "reason" + index);
                    step.data("index", index).children("hr").toggle(index > 0)
                    $("select", this).each(function (signatureIndex) {
                        $(this).attr("name", "signature" + index + "." + signatureIndex);
                    });
                }),
                count = steps.size();

            steps.eq(0).children("h3").next().toggle(count > 1);
            if (!detailPage.isReadOnly() && tab.getCurrentItem().index == 1)
               addStepButton.toggle($("div.Step", formElement).size() < maxSteps);
            resize();
        },

        fixStep = function (step) {
            var
                labels = $("label.Users", step).each(function (index) {
                    $(this)
                        .children("span")
                        .text(index == 0 ? "A user with one of the levels" : "and a user with one of the levels");
                }),
                count = labels.size();

            labels.eq(0).next().toggle(count > 1);
            $("a.Button.Add", step).toggle(count < 5);
            $("select", step).each(function (signatureIndex) {
                $(this).attr("name", "signature" + step.data("index") + "." + signatureIndex);
            });
            resize();
        },

        addUser = function (button) {
            var
                step = $(button).parent(),

                select = $("<select />").prop({
                    multiple: true
                }),

                label =
                    $("<label />")
                        .addClass("Width150 Users")
                        .insertBefore(button)
                        .append($("<span />"))
                        .append($("<i />").addClass("Icon fal fa-users"))
                        .append(select),

                a = $("<a />").insertBefore(button).attr("href", "#").addClass("Button MiniIcon Angle").append($("<i />").addClass("Icon fal fa-trash-alt")).on("click", function () {
                    label.remove();
                    a.remove();
                    fixStep(step)
                });

            for (var index in matematici.profiles)
                select.append($("<option />").text(matematici.profiles[index]).attr("value", matematici.profiles[index]));

            if (detailPage.isReadOnly()) matematici.controls.setEditable(select, false);
            var autoComplete = new matematici.AutoComplete(select);
            autoComplete.initialize();
            fixStep(step);
            setTimeout(function () {
                autoComplete.refresh();
            }, 0);

            return {
                select: select,
                label: label
            }
        },

        addStep = function (empty) {
            var step = $("<div />").addClass("Step").insertBefore(stepTab.children("div.Clearing"));
            step.append($("<hr />"));

            step.append($("<h3 />"));
            step.append($("<a />").attr("href", "#").addClass("Button MiniIcon").append($("<i />").addClass("Icon fal fa-trash-alt")).on("click", function () {
                step.remove();
                fixSteps();
            }));

            var reason;
            step.append($("<label />").addClass("Clearing Reason").append($("<span />").text("Signature reason")).append($("<i />").addClass("Icon fal fa-pencil")).append(reason = $("<input />").attr({ type: "text" })));
            if (detailPage.isReadOnly()) matematici.controls.setEditable(reason, false);

            var addUserButton = $("<a />").attr("href", "#").addClass("Button Icon Add").append($("<i />").addClass("Icon fal fa-plus")).on("click", function () {
                addUser(addUserButton);
            });
            step.append(addUserButton);
            if (!empty) addUser(addUserButton);
            fixSteps();
            return {
                step: step,
                reason: reason,
                addUserButton: addUserButton
            };
        },

        tab = new matematici.Tab(formSelector + " div.TabContainer", {
            fixedHeight: true
        }),

        parametersPrepareHandler = function () {
            var data = { steps: [] };
            $("div.Step", stepTab).each(function () {
                var step = { reason: $("input", this).val(), signatures: [] };
                $("select", this).each(function () {
                    step.signatures.push($(this).val());
                })
                data.steps.push(step);
            });
            return { data: data };
        },

        completeHandler = function () {
            if (detailPage.isNew())
                addStep();
            else {
                detailPage.getForm().trigger("Load", function (result) {
                    detailPage.getForm().handleResult(result);
                    if (result.steps) buildSteps(result.steps);
                });
            }
        },

        detailPage = new matematici.DetailPage({
            formSelector: formSelector,
            parametersPrepareHandler: parametersPrepareHandler,
            completeHandler: completeHandler, 
            width: "inherit",
            buttons: [{
                icon: "plus",
                text: "add step",
                hidden: true,
                id: "AddStep",
                handler: function () {
                    addStep();
                    return true;
                }
            }]
        }),

        buildSteps = function (steps) {
            for (var stepIndex in steps) {
                var step = addStep(true);
                step.reason.val(steps[stepIndex].reason);
                for (var userIndex in steps[stepIndex].signatures)
                    addUser(step.addUserButton).select.val(steps[stepIndex].signatures[userIndex]);
            }
            if (detailPage.isReadOnly()) $("a.Button", tab.getItem(1).tab).remove();
        },

        addStepButton = $("a#AddStep", matematici.popup.getElement());

    formElement.on("change", "select", function () {
        detailPage.getForm().onChange($(this));
    });

    if (detailPage.isReadOnly())
        $("div.Buttons a.Button", detailPage.getElement()).hide();
    else
        tab.addHandler(function (item) {
            addStepButton.toggle(item.index == 1 && $("div.Step", formElement).size() < maxSteps);
        });
</script>