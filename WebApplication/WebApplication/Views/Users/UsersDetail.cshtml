<div id="UsersDetailPage" class="GrantsDetailPage">
    <h2>User</h2>

    <form id="Detail" action="@BaseUrl/AccessControl/Users">
        <input type="hidden" name="reason" />
        <div class="TabContainer">
            <div class="TabLabels">
                <a href="#">Details</a>
                <a href="#">General grants</a>
                <a href="#">Prototype grants</a>
                <a href="#">Instance grants</a>
            </div>
            <div class="Tab">
                <label>
                    <span>User code</span>
                    <i class="Icon fal fa-key" />
                    <input type="text" name="code" />
                </label>

                <label>
                    <span>Name and surname</span>
                    <i class="Icon fal fa-id-card" />
                    <input type="text" name="description" />
                </label>

                <label class="Clearing">
                    <span>Email</span>
                    <i class="Icon fal fa-envelope" />
                    <input type="text" name="email" />
                </label>

                <label>
                    <span>Corporate ID</span>
                    <i class="Icon fal fa-key" />
                    <input type="text" name="corporateID" />
                </label>

                <label>
                    <span>Enabled</span>
                    <input type="checkbox" name="enabled" value="true" />
                </label>

                <label class="Clearing Hidden">
                    <span>Password</span>
                    <i class="Icon fal fa-lock" />
                    <input type="password" name="password" autocomplete="new-password" />
                </label>

                <label class="Hidden">
                    <span>Password confirm</span>
                    <i class="Icon fal fa-lock" />
                    <input type="password" name="password2" autocomplete="new-password" />
                </label>

                <label class="Clearing Hidden">
                    <span>Authentication code</span>
                    <i class="Icon fal fa-key" />
                    <input type="text" name="authenticationCode" />
                </label>

                <label class="Clearing Controls2">
                    <span>Creation</span>
                    <i class="Icon fal fa-user" />
                    <input type="text" name="createdBy" readonly="readonly" />
                    <i class="Icon fal fa-calendar-alt" />
                    <input type="text" name="createdOn" readonly="readonly" data-type="DateTimeOffset" />
                </label>

                <label class="Controls2">
                    <span>Last edit</span>
                    <i class="Icon fal fa-user" />
                    <input type="text" name="modifiedBy" readonly="readonly" />
                    <i class="Icon fal fa-calendar-alt" />
                    <input type="text" name="modifiedOn" readonly="readonly" data-type="DateTimeOffset" />
                </label>

                <div class="Clearing"></div>
            </div>
            <div class="Tab">
                <label>
                    <span>Role</span>
                    <select class="GeneralRole" data-nullable="(custom)" />
                </label>
                <div class="Clearing"></div>

                @Html.Partial("GeneralGrants")
                <div class="Clearing"></div>
            </div>
            <div class="Tab">
                <div class="Clearing"></div>
            </div>
            <div class="Tab">
                <div class="Clearing"></div>
            </div>
        </div>
    </form>

    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    new matematici.GrantsDetailPage("form#Detail", "Users");
</script>