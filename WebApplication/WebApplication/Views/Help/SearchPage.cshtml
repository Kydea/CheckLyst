@model HelpPage

<h3>@Model.Title</h3>

<p>
    Shows a list of @Model.RecordsName matching the filters provided. Fill the needed filter fields and click on <strong>SEARCH</strong> to see the list of matcing records.
</p>

@if (!Model.ReadOnly)
{
    <p>
        Click on a row to open the details page of that record.
    </p>
}

@if (Model.P1 != null)
{
    <p>
        @Model.P1
    </p>
}

<h4>Actions</h4>

<table>
    <tr><td>SEARCH</td><td>Applies the filters and show the result.</td></tr>
    @if (Model.Buttons != null)
    {
        foreach (var Filter in Model.Buttons)
        {
            <tr>
                <td>@Filter.Name</td>
                <td>
                    @Filter.Description
                    @if (Filter.Notes != null)
                    {
                        @Html.Raw(string.Join(" | ", Filter.Notes.Select(n => "<span class=\"Note\">" + n + "</span>")))
                    }
                </td>
            </tr>
        }
    }
    @if (!Model.ReadOnly)
    {
        <tr><td>ADD</td><td>Creates a new record.</td></tr>
        <tr><td>SAVE</td><td>Saves the record. <span class="Note">@Field.DETAILS_PAGE</span></td></tr>
        <tr><td>DELETE</td><td>Deletes the record. <span class="Note">@Field.DETAILS_PAGE</span></td></tr>
    }
</table>

@if (Model.Filters != null)
{
    <h4>Filters</h4>

    <table>
        @foreach (var Filter in Model.Filters)
        {
            <tr><td>@Filter.Name</td><td>@Filter.Description</td></tr>
        }
    </table>
}

@if (Model.Columns != null)
{
    <h4>List columns</h4>

    <table>
        @foreach (var Filter in Model.Columns)
        {
            <tr><td>@Filter.Name</td><td>@Filter.Description</td></tr>
        }

        @if (Model.IncludeLogColumns)
        {
            <tr><td>Created by</td><td>The user who created the record.</td></tr>
            <tr><td>Created by</td><td>The date and time of creation of the record.</td></tr>
            <tr><td>Modified by</td><td>The user who modified the record last time.</td></tr>
            <tr><td>Created by</td><td>The date and time of the last modification.</td></tr>
        }
    </table>
}

@if (Model.DetailFields != null)
{
    <h4>Detail fields</h4>

    <table>
        @foreach (var Filter in Model.DetailFields)
        {
            <tr>
                <td>@Filter.Name</td>
                <td>
                    @Filter.Description
                    @if (Filter.Notes != null)
                    {
                        @Html.Raw(string.Join(" | ", Filter.Notes.Select(n => "<span class=\"Note\">" + n + "</span>")))
                    }
                </td>
            </tr>
        }

        @if (Model.IncludeLogDetailFields)
        {
            <tr><td>Creation</td><td>The user, data and time of creation of the record. <span class="Note">@Field.READ_ONLY</span></td></tr>
            <tr><td>Last edit</td><td>The user, date and time of the last modification of the record. <span class="Note">@Field.READ_ONLY</span></td></tr>
        }
    </table>
}

@if (Model.DetailTabs != null)
{
    <h4>Detail tabs</h4>

    foreach (var Tab in Model.DetailTabs)
    {
        <h5>@Tab.Name</h5>
        if (Tab.Description != null)
        {
            @Html.Raw(Tab.Description)
        }
        if (Tab.Fields != null)
        {
            <table>
                @foreach (var Filter in Tab.Fields)
                {
                    <tr>
                        <td>@Filter.Name</td>
                        <td>
                            @Filter.Description
                            @if (Filter.Notes != null)
                            {
                                @Html.Raw(string.Join(" | ", Filter.Notes.Select(n => "<span class=\"Note\">" + n + "</span>")))
                            }
                        </td>
                    </tr>
                }

                @if (Tab.IncludeLogFields)
                {
                    <tr><td>Creation</td><td>The user, data and time of creation of the record. <span class="Note">@Field.READ_ONLY</span></td></tr>
                    <tr><td>Last edit</td><td>The user, date and time of the last modification of the record. <span class="Note">@Field.READ_ONLY</span></td></tr>
                }
            </table>
        }
    }
}