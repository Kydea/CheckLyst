<h3>Software version</h3>

<table id="SoftwareVersionHelpPage">
    <tr><td>Service</td><td class="Strong">Version</td></tr>
    <tr><td>Web application</td><td>@CheckListManager.WebApplication.Code.Version.Get()</td></tr>
    <tr id="AccessControl"><td>Access control</td><td ><span class="Grey">(wait)</span></td></tr>
    <tr id="Trail"><td>Audit trail</td><td ><span class="Grey">(wait)</span></td></tr>
    <tr id="DataSources"><td>Data sources</td><td ><span class="Grey">(wait)</span></td></tr>
    <tr id="Infrastructure"><td>Infrastructure</td><td ><span class="Grey">(wait)</span></td></tr>
    <tr id="Instances"><td>Instances</td><td><span class="Grey">(wait)</span></td></tr>
    <tr id="Prototypes"><td>Prototypes</td><td><span class="Grey">(wait)</span></td></tr>
    <tr id="Reports"><td>Reports</td><td><span class="Grey">(wait)</span></td></tr>
    <tr id="WorkFlows"><td>Workflows</td><td><span class="Grey">(wait)</span></td></tr>
</table>

<script>
    $("tr", "table#SoftwareVersionHelpPage").each(function () {
        console.log();
        var
            tr = this,
            id = tr.getAttribute("id");
        if (id)
            $.ajax({
                url: matematici.urls.api + "/" + this.getAttribute("id") + "/ReleaseInfo",
                type: "get",
                contentType: "application/json; charset=utf-8",
                suppressErrors: true
            }).done(function (result) {
                $("td", tr).each(function (index) {
                    if (index == 1)
                        this.innerText = result && result.version || ""
                    //else if (index == 2) this.innerText = result && result.buildDate && matematici.dateFormatter.both(moment(result.buildDate)) || "";
                });
            });
    });
</script>