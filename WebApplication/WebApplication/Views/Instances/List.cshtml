<div id="InstancesListPage">
    <h1>Instances List</h1>

    <div class="ActionBar">
        <a id="ApplyButton" class="Button DefaultButton"><i class="fa fa-search"></i> search</a>
    </div>

    <form id="Filters" action="/API/Instances/List">
        <label>
            Department
            <select name="department" class="Trigger" />
        </label>
        <label>
            Prototype Type
            <select name="prototypeType" class="Trigger" />
        </label>
        <label>
            Prototype
            <select name="prototype" class="Trigger" />
        </label>
        <label>
            Version
            <select name="version" class="Trigger" />
        </label>
        <label>
            Instance Description
            <input type="text" name="description" />
        </label>
        <label>
            Tags
            <select name="tabCode" />
        </label>
        <label>
            Tag Value
            <select name="tabValue" />
        </label>
        <label>
            State
            <select name="state" />
        </label>
    </form>

    <table class="Grid">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Version</th>
                <th>Validity Start Date</th>
                <th>Validity End Date</th>
                <th>Created By</th>
                <th>Created On</th>
                <th>Modified By</th>
                <th>Modified On</th>
                <th>State</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td data-column="id"></td>
                <td data-column="name"></td>
                <td data-column="description"></td>
                <td data-column="version"></td>
                <td data-column="validityFrom" data-type="DateTimeOffset"></td>
                <td data-column="validityUntil" data-type="DateTimeOffset"></td>
                <td data-column="createdBy"></td>
                <td data-column="createdOn" data-type="DateTimeOffset"></td>
                <td data-column="modifiedBy"></td>
                <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                <td data-column="versionState"></td>
            </tr>
            <tr class="NoRecord"><td>(no record)</td></tr>
        </tbody>
    </table>
    <div class="Paginator"></div>
    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var grid,
            form,
            paginator,
            handler = function (result) {
                grid.update(result.data);
                paginator.setPage(result.currentPage, result.pagesCount);
            };

        new matematici.ActionBar("div.ActionBar");

        new matematici.Page({
            name: "InstancesList",
            initializers: [
                //new matematici.FixedHeader("div#Content table.Grid")
                grid = new matematici.Grid("div#Content table.Grid"),
                form = new matematici.Form("form#Filters", {
                    applyButton: {
                        button: "#ApplyButton",
                        event: "GetData",
                        handler: handler
                    },
                    bindEvent: "Bind"
                }),
                matematici.p = paginator = new matematici.Paginator("div#Content div.Paginator", function (index) {
                    form.trigger("GetData", handler, { CurrentPage: index });
                })
            ]
        });

        callback.call();
    };
</script>