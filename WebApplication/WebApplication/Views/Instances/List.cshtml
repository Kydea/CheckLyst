<div id="InstancesListPage">
    <h1>Instances List</h1>

    <div class="ActionBar">
        <a id="AddButton" href="#" class="Button"><i class="Icon fa fa-plus"></i> New instance</a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Instances/List">
            <label class="Controls2">
                <span>Department / prototype type</span>
                <i class="Icon fal fa-industry" />
                <select name="department" class="Trigger" />
                <i class="Icon fal fa-folder" />
                <select name="prototypeType" class="Trigger" />
            </label>
            <label class="Controls2">
                <span>Prototype / version</span>
                <i class="Icon fal fa-file-invoice" />
                <select name="prototype" class="Trigger" data-nullable="(all)" />
                <i class="Icon fal fa-list-ol" />
                <select name="version" class="Trigger" data-nullable="(all)" />
            </label>
            <label class="Clearing">
                <span>Instance description</span>
                <i class="Icon fal fa-layer-group" />
                <input type="text" name="description" />
            </label>
            <label>
                <span>State</span>
                <i class="Icon fal fa-file-invoice" />
                <select name="state" data-nullable="(all)" />
            </label>
            <label class="Controls2">
                <span>Tag / value</span>
                <i class="Icon fal fa-tag" />
                <select name="tagCode" data-nullable="(all)" />
                <i class="Icon fal fa-align-left" />
                <input type="text" name="tagValue" />
            </label>

            <div class="AdvancedSearch">
                <label class="Controls2">
                    <span>Last update date range</span>
                    <input type="text" name="from" class="DatePicker" />
                    <input type="text" name="to" class="DatePicker" />
                </label>
                <label class="Clearing">
                    <span>Exception state</span>
                    <i class="Icon fal fa-file-invoice" />
                    <select name="exceptionState" />
                </label>
                <label>
                    <span>Exception description</span>
                    <i class="Icon fal fa-exclamation" />
                    <input type="text" name="exceptionDescription" />
                </label>
            </div>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>State</th>
                    <th>Year</th>
                    <th>Number</th>
                    <th>Description</th>
                    <th class="AdvancedSearch">Exceptions</th>
                    <th>Department</th>
                    <th>Prototype type</th>
                    <th>Prototype</th>
                    <th>Version</th>
                    <th>Created By</th>
                    <th>Created On</th>
                    <th>Modified By</th>
                    <th>Modified On</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="instanceCode"></td>
                    <td data-column="state" style="min-width: 120px;"></td>
                    <td data-column="year"></td>
                    <td data-column="number"></td>
                    <td data-column="description" style="min-width: 250px;"></td>
                    <td class="AdvancedSearch" data-column="exceptions" data-type="Custom" style="min-width: 250px;"></td>
                    <td data-column="departmentName"></td>
                    <td data-column="prototypeTypeName"></td>
                    <td data-column="prototypeName"></td>
                    <td data-column="version"></td>
                    <td data-column="createdBy"></td>
                    <td data-column="createdOn" data-type="DateTimeOffset"></td>
                    <td data-column="modifiedBy"></td>
                    <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var
            formSelector = "form#Filters",
            formElement = $(formSelector);

        new matematici.SearchPage({
            pageName: "Instances",
            detailUrl: "@Url.Action("Detail")",
            filterFormSelector: formSelector,
            resultGridSelector: "div#Content table.Grid",
            bindEvent: "Bind",
            readOnly: true,
            breadCrumbs: [
                { content: "instances" }
            ],
            rowClickHandler: function (row) {
                matematici.navigator.open("@Url.Action("Detail")/" + encodeURIComponent(row.data("values").code));
            },
            setCellValueHandler: function (cell, data, column, type, value) {
                if (column == "exceptions" && value)
                    for (var index in value) {
                        var exception = value[index];
                        cell.addClass("Red").append($("<span />").addClass("Block").text(exception.description));
                    }
            }
        });

        $("#AddButton").on("click", function () {
            var
                versionName = $("select[name=version]", formElement).next().val(),
                department = $("select[name=department]", formElement).val(),
                prototypeType = $("select[name=prototypeType]", formElement).val();

            //if (!versionName)
            //    matematici.dialog.error("Error", "Select an active prototype version to create a new instance.");
            //else if (!versionName.endsWith(" Active"))
            //    matematici.dialog.error("Error", "The selected prototype version is not active.");
            //else 

            if (
                !matematici.tokenManager.checkRole("Instances#Create#" + department + "##")
                && !matematici.tokenManager.checkRole("Instances#Create#" + department + "#" + prototypeType + "#")
                || !matematici.tokenManager.checkRole("Instances#Edit#" + department + "##")
                && !matematici.tokenManager.checkRole("Instances#Edit#" + department + "#" + prototypeType + "#")
            )
                matematici.dialog.error("Error", "Permission denied.");
            else {
                var prototype = $("select[name=prototype]", formElement).val();

                //version = $("select[name=version]", formElement).val();
                matematici.navigator.open("@Url.Action("Create")/" + prototype);
            }
        });
        callback.call();
    };
</script>
