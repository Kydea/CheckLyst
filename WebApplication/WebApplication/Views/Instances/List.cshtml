<div id="InstancesListPage">
    <h1>Instances List</h1>

    <div class="ActionBar">
        <a id="LinkButton" href="#" class="Button Icon"><i class="Icon fa fa-link"></i></a>
        <a id="ExportButton" href="#" class="Button"><i class="Icon fa fa-caret-down"></i> Export</a>
        <a id="AddButton" href="#" class="Button"><i class="Icon fa fa-plus"></i> New instance</a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Instances/List">
            <label class="Controls1-2">
                <span>Department / prototype type</span>
                <i class="Icon fal fa-industry"></i>
                <select name="department" class="Trigger" data-nullable="(all)"></select>
                <i class="Icon fal fa-folder"></i>
                <select name="prototypeType" class="Trigger" data-nullable="(all)"></select>
            </label>
            <label class="Controls2-1">
                <span>Prototype / version</span>
                <i class="Icon fal fa-file-invoice"></i>
                <select name="prototype" class="Trigger" data-nullable="(all)"></select>
                <i class="Icon fal fa-list-ol"></i>
                <select name="version" class="Trigger" data-nullable="(all)"></select>
            </label>
            <label class="Clearing">
                <span>Instance ID</span>
                <i class="Icon fal fa-key"></i>
                <input type="text" name="id" class="mask-pint" maxlength="18" />
            </label>
            <label>
                <span>Instance description</span>
                <i class="Icon fal fa-layer-group"></i>
                <input type="text" name="description" />
            </label>
            <label class="Width200 ">
                <span>State</span>
                <i class="Icon fal fa-file-invoice"></i>
                <select name="state" data-nullable="(all)"></select>
            </label>
            <label class="Controls2 Clearing">
                <span>Tag / value</span>
                <i class="Icon fal fa-tag"></i>
                <select name="tagCode" data-nullable="(all)"></select>
                <i class="Icon fal fa-align-left"></i>
                <input type="text" name="tagValue" />
            </label>

            <div class="AdvancedSearch">
                <label class="Controls2">
                    <span>Last update date range</span>
                    <input type="text" name="from" class="DatePicker" />
                    <input type="text" name="to" class="DatePicker" />
                </label>
                <label class="Clearing">
                    <span>Exception state</span>
                    <i class="Icon fal fa-file-invoice"></i>
                    <select name="exceptionState"></select>
                </label>
                <label>
                    <span>Exception description</span>
                    <i class="Icon fal fa-exclamation"></i>
                    <input type="text" name="exceptionDescription" />
                </label>
                <label class="Clearing Controls2">
                    <span>life cycle % range</span>
                    <i class="Icon fal fa-clock"></i>
                    <input type="text" name="lifeCycleFrom" class="mask-pint" maxlength="3" />
                    <i class="Icon fal fa-clock"></i>
                    <input type="text" name="lifeCycleTo" class="mask-pint" maxlength="3" />
                </label>
            </div>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>State</th>
                    <th>Year</th>
                    <th>Number</th>
                    <th>Description</th>
                    <th class="AdvancedSearch">Exceptions</th>
                    <th>Department</th>
                    <th>Prototype type</th>
                    <th>Prototype</th>
                    <th>Version</th>
                    <th>Life cycle</th>
                    <th>Created by</th>
                    <th>Created on</th>
                    <th>Modified by</th>
                    <th>Modified on</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="instanceCode"></td>
                    <td data-column="state" style="min-width: 120px;"></td>
                    <td data-column="year"></td>
                    <td data-column="number"></td>
                    <td data-column="description" style="min-width: 250px;"></td>
                    <td class="AdvancedSearch" data-column="exceptions" data-type="Custom" style="min-width: 250px;"></td>
                    <td data-column="departmentName"></td>
                    <td data-column="prototypeTypeName"></td>
                    <td data-column="prototypeName"></td>
                    <td data-column="version"></td>
                    <td data-column="lifeCycle" style="white-space: nowrap;"></td>
                    <td data-column="createdBy"></td>
                    <td data-column="createdOn" data-type="DateTimeOffset"></td>
                    <td data-column="modifiedBy"></td>
                    <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var
            formSelector = "form#Filters",
            formElement = $(formSelector),
            linkButton = $("#LinkButton"),
            addButton = $("#AddButton"),

            searchPage = new matematici.SearchPage({
                pageName: "Instances",
                detailUrl: "@Url.Action("Detail")",
                filterFormSelector: formSelector,
                resultGridSelector: "div#Content table.Grid",
                bindEvent: "Bind",
                readOnly: true,
                breadCrumbs: [
                    { content: "instances" }
                ],
                rowClickHandler: function (row) {
                    window.open("@Url.Action("Detail")/" + encodeURIComponent(row.data("values").code));
                },
                setCellValueHandler: function (cell, data, column, type, value) {
                    if (column == "exceptions" && value)
                        for (var index in value) {
                            var exception = value[index];
                            cell.addClass("Red").append($("<span />").addClass("Block").text(exception.description));
                        }
                }
            });

        $("#LinkButton").on("click", function () {
            var
                prototype = $("select[name=prototype]", formElement).val(),
                prototypeName = $("select[name=prototype]", formElement).next().val(),
                url = matematici.urls.webApplication + "@Url.Action("Create")/" + prototype;

            if (!prototypeName)
                matematici.dialog.error("Error", "Select a prototype.");
            else
                matematici.dialog.show("new instance link", url, [{
                    hidden: true,
                    cancelButton: true
                }, {
                    text: "copy",
                    icon: "copy",
                    defaultButton: true,
                    handler: function () {
                        matematici.clipboard.copy(url);
                    }
                }]);
        });

        $("#ExportButton").on("click", function () {
            searchPage.getForm().trigger("Export", function (result) {
                location = searchPage.getForm().getElement().attr("action") + "/Export?Token=" + result.token;
            })
        });

        if (matematici.tokenManager.checkRole("Instances#Create#"))
            addButton.on("click", function () {
                var
                    prototype = $("select[name=prototype]", formElement).val(),
                    prototypeName = $("select[name=prototype]", formElement).next().val();

                searchPage.getForm().saveForm();

                if (!prototypeName)
                    matematici.dialog.error("Error", "Select a prototype to create a new instance.");
                else
                    $.ajax({
                        url: matematici.urls.instances.api + "/CheckCreationGrants",
                        type: "post",
                        data: { prototype: prototype }
                    }).done(function () {
                        window.open("@Url.Action("Create")/" + prototype);
                    });
            });
        else {
            linkButton.hide();
            addButton.hide();
        }

        $("input[name=id]").keyfilter(/[\d]/);

        matematici.notificationPollingClient.addNotificationListener("/Instances/List", function (code, value) {
            var autoComplete = matematici.AutoComplete.get(document.querySelector("select[name=\"state\"]"));
            autoComplete.setNotificationBadge("Own", value);
        });

        callback.call();
    };

    matematici.events.onPageUnload = function (callback) {
        matematici.notificationPollingClient.removeNotificationListener("/Instances/List");
        callback.call();
    };
</script>
