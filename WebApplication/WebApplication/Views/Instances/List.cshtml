<div id="InstancesListPage">
    <h1>Instances List</h1>

    <div class="ActionBar"></div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Instances/List">
            <label class="Controls2">
                <span>Prototype type</span>
                <i class="Icon fi flaticon-building-o" />
                <select name="department" class="Trigger" />
                <i class="Icon fi flaticon-folder-o" />
                <select name="prototypeType" />
            </label>
            <label class="Controls2">
                <span>Prototype</span>
                <i class="Icon fi flaticon-prototype" />
                <select name="prototype" class="Trigger" />
                <i class="Icon fi flaticon-version" />
                <select name="version" class="Trigger" />
            </label>
            <label class="Clearing">
                <span>Instance description</span>
                <i class="Icon fi flaticon-instance" />
                <input type="text" name="description" />
            </label>
            <label>
                <span>State</span>
                <i class="Icon fi flaticon-prototype" />
                <select name="state" />
            </label>
            <label class="Controls2">
                <span>Tag value</span>
                <i class="Icon fi flaticon-tags-o" />
                <select name="tagCode" />
                <i class="Icon fi flaticon-align-left" />
                <input type="text" name="tagValue" />
            </label>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Version</th>
                    <th>Validity Start Date</th>
                    <th>Validity End Date</th>
                    <th>Created By</th>
                    <th>Created On</th>
                    <th>Modified By</th>
                    <th>Modified On</th>
                    <th>State</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td data-column="id"></td>
                    <td data-column="name"></td>
                    <td data-column="description"></td>
                    <td data-column="version"></td>
                    <td data-column="validityFrom" data-type="DateTimeOffset"></td>
                    <td data-column="validityUntil" data-type="DateTimeOffset"></td>
                    <td data-column="createdBy"></td>
                    <td data-column="createdOn" data-type="DateTimeOffset"></td>
                    <td data-column="modifiedBy"></td>
                    <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                    <td data-column="versionState"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.SearchPage({
            pageName: "Instances",
            detailUrl: "@Url.Action("Detail")",
            filterFormSelector: "form#Filters",
            resultGridSelector: "div#Content table.Grid",
            breadCrumbs: [
                { content: "instances" }
            ]
        });

        callback.call();
    };
</script>
