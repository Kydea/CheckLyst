@model CheckListManager.WebApplication.Models.Instance

<div id="InstancesDetailPage" class="Instance CheckList Loading" data-api="@BaseUrl">
    <h1>Instance Manager</h1>

    <div class="ActionBar">
        <span class="ButtonGroup" data-text="Actions"></span>
    </div>

    <div class="ShadowPanel">
        <div class="HeaderContainer">
            <h2></h2>

            <div id="Header" class="Group"></div>
        </div>

        <div class="TabContainer MultiLine">
            <div class="TabLabels"></div>
        </div>

        <div class="Element Page Tab"></div>
    </div>
</div>

<div class="PropertyPanel">
    <div class="PropertyList"></div>
    <div class="PropertyValue"></div>
    <div class="Information"></div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        @if (ViewBag.AppMode)
        {
            <text>
                matematici.tokenManager.setUserCode("@ViewBag.AppUser", "@ViewBag.AppRoles", "@ViewBag.AppTimeZone", "@ViewBag.AppDecimalSeparator", "@ViewBag.AppAccessToken", "@ViewBag.AppRefreshToken");
            </text>
        }

        new matematici.Page({
            name: "InstanceManager",
            cssClass: "InstanceManager CheckList",
            breadcrumbs: [
                { content: "instance manager" }
            ],
        });

        var
            element = $("#InstancesDetailPage"),
            instance = new instances.Instance(element, {
                code: "@(Model.Code ?? "")",
                prototype: "@(Model.Prototype ?? -1)",
                version: "@(Model.Version ?? -1)",
                detailUrl: "@Url.Action("Detail")",
                listUrl: "@Url.Action("List")",
                appMode: "@(ViewBag.AppMode ? 1 : 0)" == "1"
            }),

            actionBar = new matematici.ActionBar("div.ActionBar")
                .add("<i class='Icon fa fa-calculator'></i>", function () {
                    new matematici.CheckListGrid(instance.getExpressions(), null, function (tr, row, rowIndex, columnIndex, passedValue) {
                        var
                            typeName = row.typeName,
                            value = row.value;

                        if (columnIndex == 2) {
                            var td = $("<td />").appendTo(tr);
                            if (typeName == "DateTime" || typeName == "Date") {
                                if (value) {
                                    var
                                        formattedDate = matematici.dateFormatter.format(moment.parseZone(value)),
                                        formattedValue = typeName == "DateTime" ? formattedDate.date + " " + formattedDate.time + ":" + formattedDate.seconds : formattedDate.date;

                                    td.append($("<span />").html(formattedValue).attr("title", formattedDate.offset));
                                }
                            } else if (typeName == "Array") {
                                td.text("(click to open)");
                                tr.addClass("Handler");
                                tr.on("click", function () {
                                    instance.showArray($(this));
                                    matematici.checkListGrid.close();
                                }).data("array", value);
                            } else if (typeName == "Boolean") {
                                td.addClass("Centered").append($("<i />").addClass("fa").addClass("fa-" + (value || value == true ? "check" : "times")));
                            } else
                                td.html(value);
                            return true;
                        } else if (columnIndex == 3) {
                            var td = $("<td />").appendTo(tr);
                            td.html(row.typeName);
                            return true;
                        }
                        return false;
                    }, [
                        { label: "Code" },
                        { name: "description", label: "Description" },
                        { label: "Value" },
                        { label: "Type" }
                    ]);
                }, "Icon ExpressionsButton")
                .add("<i class='Icon fa fa-exclamation'></i>", function () {
                    instance.showExceptions();
                }, "Icon Invalid ExceptionsButton Hidden"),

            buttonGroup = new matematici.ButtonGroup("span.ButtonGroup")
                .add("History", function () {
                    instance.showHistory();
                }, "History")
                @if (!ViewBag.AppMode)
                {
                    <text>
                        .add("Quit", function () {
                            instance.quit();
                        }, "Quit")
                        .add("Download", function () {
                           instance.download();
                        }, "Download")
                    </text>
                }
                .add("Save", function () {
                    instance.save();
                }, "Save")
                .add("Delete", function () {
                    instance.delete();
                }, "Delete")
                .add("Complete", function () {
                    instance.complete();
                }, "Complete")
                .add("Confirm", function () {
                    instance.confirm();
                }, "Confirm")
                .add("Show deleted iterations", function () {
                    instance.toggleRemovedIterations(true);
                }, "ShowRemovedIterations")
                .add("Hide deleted iterations", function () {
                    instance.toggleRemovedIterations(false);
                }, "HideRemovedIterations");

        matematici.save = instance.save;

        matematici.events.onPageUnload = function (callback) {
            instance.close(callback);
        };

        callback.call();
    };

</script>