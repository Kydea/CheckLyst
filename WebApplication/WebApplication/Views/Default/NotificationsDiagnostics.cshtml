@{
    ViewBag.Title = "Notifications diagnostics";
}

<div class="NotificationsDiagnostics">

    <style>
        form > #ApplyButton {
            display: none;
        }

        p {
            margin-top: 20px;
            margin-left: 20px;
            float: left;
        }
    </style>

    <h1>Notifications diagnostics</h1>

    <div class="ActionBar">
        <a id="ApplyButton" class="Button" href="#">Refresh<i class="Icon fa fa-caret-right"></i></a>
    </div>

    <div class="ShadowPanel">
        <h2 class="Green">Information</h2>
        <form id="NotificationsDiagnosticsForm" action="@BaseUrl/Infrastructure/Notifications" style="border: none !important; padding-bottom: 0 !important; margin: -20px !important; background: none;">
            <div class="TabContainer" style="margin-left: 0 !important;">
                <div class="TabLabels">
                    <a href="#">Filters</a>
                    <a href="#">Snapshot</a>
                </div>
                <div class="Tab">
                    <label>
                        <span>Minimum level</span>
                        <select name="level">
                            <option value="Trace">Trace</option>
                            <option value="Debug">Debug</option>
                            <option value="Info">Info</option>
                            <option value="Warning">Warning</option>
                            <option value="Error">Error</option>
                        </select>
                    </label>

                    <label>
                        <span>event</span>
                        <input type="text" name="event" />
                    </label>

                    <label>
                        <span>company</span>
                        <input type="text" name="company" />
                    </label>

                    <label>
                        <span>user</span>
                        <input type="text" name="user" />
                    </label>

                    <div class="Clearing"></div>
                </div>
                <div class="Tab Log">
                    <label class="Clearing">
                        <span>globalWaiters</span><br>
                        <input type="text" name="globalWaiters" readonly />
                    </label>
                    <p>
                        Currently open long-poll requests.<br>
                        OK: stable / oscillating<br>
                        Warning: keeps growing and does not drop
                    </p>

                    <label class="Clearing">
                        <span>total wakeups</span><br>
                        <input type="text" name="totalWakeups" readonly />
                    </label>
                    <p>
                        Polls completed because of a real update.<br>
                        Read as delta/rate, not as an absolute total.<br>
                        OK: increases when the system is active
                    </p>

                    <label class="Clearing">
                        <span>total timeouts</span><br>
                        <input type="text" name="totalTimeouts" readonly />
                    </label>
                    <p>
                        Polls completed by natural timeout (30s).<br>
                        Read as delta/rate.<br>
                        Note: high values alone are not abnormal
                    </p>

                    <label class="Clearing">
                        <span>total overload returns</span><br>
                        <input type="text" name="totalOverloadReturns" readonly />
                    </label>
                    <p>
                        Polls not put in wait state because limits/load were reached.<br>
                        OK: should stay at 0<br>
                        Alert: any increase
                    </p>

                    <label class="Clearing">
                        <span>total aborts</span><br>
                        <input type="text" name="totalAborts" readonly />
                    </label>
                    <p>
                        Polls interrupted by client/network.<br>
                        OK: small increases are normal<br>
                        Warning: high or continuous growth
                    </p>

                    <label class="Clearing">
                        <span>total wait completed</span><br>
                        <input type="text" name="totalWaitCompleted" readonly />
                    </label>
                    <p>
                        Normally completed waits.<br>
                        Check: should equal <code>totalWakeups + totalTimeouts</code>
                    </p>

                    <label class="Clearing">
                        <span>total wait (ms)</span><br>
                        <input type="text" name="totalWaitMillisecons" readonly />
                    </label>
                    <p>
                        Sum of completed wait times.<br>
                        Useful only as the base for the average
                    </p>

                    <label class="Clearing">
                        <span>average wait (ms)</span><br>
                        <input type="text" name="averageWaitMillisecons" readonly />
                    </label>
                    <p>
                        Average completed poll wait time.<br>
                        ~30000 ms: mostly timeouts<br>
                        &lt;30000 ms: frequent wakeups
                    </p>

                    <label class="Clearing">
                        <span>server time utc</span><br>
                        <input type="text" name="serverTimeUtc" readonly />
                    </label>
                    <p>
                        Diagnostic snapshot timestamp
                    </p>

                    <p style="clear: both;">
                        <strong>Quick rules</strong><br>
                        - Read all total values as recent delta or rate/min<br>
                        - High timeouts alone do not mean an error<br>
                        - total overload returns &gt; 0 is abnormal<br>
                        - If the system is active but wakeups stay near zero, investigate<br>
                        - If global waiters keeps growing, investigate<br>
                        - If aborts grow significantly, check client/network
                    </p>

                    <label class="FullWidth">
                        <span>Full result</span>
                        <textarea id="Output" readonly style="height: 400px"></textarea>
                    </label>
                </div>
            </div>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>Squence</th>
                    <th>Timestamp</th>
                    <th>Last loaded</th>
                    <th>Level</th>
                    <th>Event</th>
                    <th>Source</th>
                    <th>Company</th>
                    <th>User</th>
                    <th>Since version</th>
                    <th>Version</th>
                    <th>Mask</th>
                    <th>Completed</th>
                    <th>Enqueued</th>
                    <th>Reports to sign</th>
                    <th>Instances to sign</th>
                    <th>Prototype versions to sign</th>
                    <th>Idle</th>
                    <th>Valid</th>
                    <th>Active waiters</th>
                    <th>Global waiters</th>
                    <th>In flight</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="sequence"></td>
                    <td data-column="timestampUtc" data-type="DateTimeOffset"></td>
                    <td data-column="lastLoadedUtc" data-type="DateTimeOffset"></td>


                    <td data-column="levelDescription"></td>
                    <td data-column="eventType"></td>
                    <td data-column="source"></td>

                    <td data-column="company"></td>
                    <td data-column="user"></td>

                    <td data-column="sinceVersion"></td>
                    <td data-column="version"></td>

                    <td data-column="mask"></td>

                    <td data-column="completedReportCount"></td>
                    <td data-column="enqueuedReportCount"></td>
                    <td data-column="reportsToSignCount"></td>
                    <td data-column="instancesToSignCount"></td>
                    <td data-column="prototypeVersionsToSignCount"></td>

                    <td data-column="idle" data-type="Boolean"></td>
                    <td data-column="valid" data-type="Boolean"></td>

                    <td data-column="activeWaiters"></td>
                    <td data-column="globalWaiters"></td>
                    <td data-column="inFlight"></td>

                    <td data-column="note"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing" style="padding: 20px;"></div>
    </div>
</div>

<script type="text/javascript">
    var
        tab,
        textArea = document.getElementById("Output"),
        formSelector = "form#NotificationsDiagnosticsForm";

    matematici.events.onPageLoad = function (callback) {
        var searchPage = new matematici.SearchPage({
            pageName: "NotificationsDiagnostics",
            filterFormSelector: formSelector,
            resultGridSelector: "div#Content table.Grid",
            getDataEvent: "Diagnostics",
            searchButtonLabel: "refresh",
            readOnly: true,
            breadCrumbs: [
                { content: "notifications diagnostics" }
            ],
            filterHandler: function (data) {
                console.log(data);
                for (var key in data)
                    $(".Log input[name='" + key + "']", formSelector).val(data[key]);

                textArea.value = JSON.stringify(data, null, 4);
                tab.resize();
            }
        });

        tab = new matematici.Tab(formSelector + " div.TabContainer", {
            //fixedHeight: true
        });

        callback.call();
    };
</script>