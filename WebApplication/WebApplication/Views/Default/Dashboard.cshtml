    <script type="text/javascript">
        matematici.events.onPageLoad = function (callback) {
            new matematici.Page({
                name: "Dashboard",
                helpPage: "Dashboard",
                initializers: [
                    //new matematici.Home("div.Home", images)
                ],
                breadcrumbs: [
                    { content: "parent page", url: "#" },
                    { content: "this page" },
                ]
            });

            function submit(form) {
                $.ajax({
                    url: form.attr("action"),
                    type: "post",
                    data: form.serialize()
                }).done(function (result) {
                    $("#DashboardPage").html(result);
                    matematici.events.onPageLoad(callback);
                }).fail(function (jqXhr, textStatus, errorThrown) {
                    console.log("Server error", jqXhr, textStatus, errorThrown);
                    alert("Server error: " + errorThrown);
                });
            }

            new matematici.Pager(function () {
                submit($(".PrototypesVersions form"));
            }, ".PrototypesVersions .Pager", ".PrototypesVersions form");

            new matematici.Pager(function () {
                submit($(".Instances form"));
            }, ".Instances .Pager", ".Instances form");

            $("table.Grid").on("click", "tr.Handler", function () {
                matematici.navigator.open($(this).data("open-url"));
            });

            callback.call();
        };
    </script>
</div>