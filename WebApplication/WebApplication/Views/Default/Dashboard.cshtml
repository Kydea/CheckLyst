@{
    ViewBag.Title = "Dashboard";
}

<h1>Dashboard</h1>

<div class="Dashboard">

    <a href="@Url.Action("List", "Prototypes")" class="DashboardItem" id="PrototypesDashboardItem">
        <img src="~/Content/Media/Dashboard/Prototypes.jpg" />
        <i class="fi flaticon-prototype"></i>
        <span>Prototypes</span>
    </a>

    <a href="@Url.Action("List", "Instances")" class="DashboardItem" id="InstancesDashboardItem">
        <img src="~/Content/Media/Dashboard/Instances.jpg" />
        <i class="fi flaticon-instance"></i>
        <span>Instances</span>
    </a>

    <a href="#" class="DashboardItem" id="PinDashBoardItem">
        <img src="~/Content/Media/Dashboard/Pin.jpg" />
        <i class="fi flaticon-key-o"></i>
        <span>Change PIN</span>
    </a>

    <a href="@Url.Action("Login", "Security")" class="DashboardItem" id="LogoutDashboardItem">
        <img src="~/Content/Media/Dashboard/Logout.jpg" />
        <i class="fi flaticon-logout"></i>
        <span>Logout</span>
    </a>

    <a href="#" class="DashboardItem" id="HelpDashboardItem">
        <img src="~/Content/Media/Dashboard/Help.jpg" />
        <i class="fi flaticon-question"></i>
        <span>Help</span>
    </a>

    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "Dashboard",
            helpPage: "Dashboard",
            initializers: [
            ],
            breadcrumbs: [
                { content: "Dashboard" },
            ]
        });

        var count = 3;

        if (matematici.tokenManager.checkRole("Prototypes#Edit#"))
            ++count;
        else
            $("#PrototypesDashboardItem").hide();

        if (matematici.tokenManager.checkRole("Instances#Edit#"))
            ++count;
        else
            $("#InstancesDashboardItem").hide();

        $("#PinDashBoardItem").on("click", function () {
            matematici.userPanel.profile();
        });

        $(".Dashboard").addClass("Controls" + count);

        callback.call();
    };
</script>
