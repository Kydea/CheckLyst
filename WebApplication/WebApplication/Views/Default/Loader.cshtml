@model string

<div id="LoaderPage">
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "Loader",
            helpPage: "",
            initializers: [],
            breadcrumbs: []
        });

        var
            url,
            appMode = "@(ViewBag.AppMode)" == "True",
            instanceManager = "@(Model.StartsWith("Instances/Detail") || Model.StartsWith("Instances/Create"))" == "True",
            search = "",
            iPad =
                (userAgent.match(/(iPad)/) /* iOS pre 13 */ ||
                (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1) /* iPad OS 13 */);

        if (instanceManager) search = window.location.search;

        if (!appMode && iPad && instanceManager) {
            url = "checklyst://" + window.location.host + "/" + window.location.pathname + search;
            window.location = url;
        } else {
            url = "@Model" + search + "@(ViewBag.AppMode ? "&AppUser=" + ViewBag.AppUser : string.Empty)";
            matematici.navigator.open(url);
        }

        callback.call();
    };

    matematici.events.onPageUnload = function (callback) {
        matematici.loader.checkInitialCurtain();
        callback.call();
    }
</script>
