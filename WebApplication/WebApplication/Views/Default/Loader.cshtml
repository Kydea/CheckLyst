@model string

<div id="LoaderPage">
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "Loader",
            helpPage: "",
            initializers: [],
            breadcrumbs: []
        });

        matematici.navigator.open("@Model@(ViewBag.AppMode ? "?AppMode=1" : string.Empty)");

        callback.call();
    };

    matematici.events.onPageUnload = function (callback) {
        matematici.loader.checkInitialCurtain();
        callback.call();
    }    
</script>
