@model string

<div id="LoaderPage">
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.Page({
            name: "Loader",
            helpPage: "",
            initializers: [],
            breadcrumbs: []
        });

        var url;

        if ("@(ViewBag.AppMode)" != "True" && navigator.userAgent.match(/iPad/i) != null && "@(Model.StartsWith("Instances/Detail") || Model.StartsWith("Instances/Create"))" == "True") {
            url = "checklyst://" + window.location.host + "/" + window.location.pathname;
            window.location = url;
        } else {
            url = "@Model@(ViewBag.AppMode ? "?AppUser=" + ViewBag.AppUser : string.Empty)";
            matematici.navigator.open(url);
        }

        callback.call();
    };

    matematici.events.onPageUnload = function (callback) {
        matematici.loader.checkInitialCurtain();
        callback.call();
    }
</script>
