<div id="SourceEditor">
    <h2>Source Editor</h2>

    <form id="Detail">
        <div class="Fields">
            <label>
                <span>Code</span>
                <i class="Icon fal fa-key"></i>
                <input type="text" name="code" autocomplete="off" maxlength="50" />
            </label>

            <label class="Width200">
                <span>Source</span>
                <i class="Icon fal fa-chart-network"></i>
                <select name="dataSource" data-nullable="-"></select>
            </label>
        </div>

        <label class="GridLabel">Parameters</label>
        <table class="Grid">
            <thead>
                <tr>
                    <th>name</th>
                    <th>binding</th>
                    <th>bound to</th>
                    <th>hidden</th>
                    <th>read only</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Parameter">
                    <td></td>
                    <td>
                        <select name="binding" data-nullable="(not bound)">
                            <option value="expression">expression</option>
                            <option value="field">field</option>
                        </select>
                    </td>
                    <td>
                        <select name="code"></select>
                    </td>
                    <td><input type="checkbox" name="hidden" /></td>
                    <td><input type="checkbox" name="readOnly" /></td>
                </tr>
                <tr class="NoRecord"><td colspan="5">(no parameter)</td></tr>
            </tbody>
        </table>
    </form>
</div>

<script type="text/javascript">
    var
        sourceEditor = matematici.popup.getData(),
        form = $("div#SourceEditor form#Detail");

    sourceEditor.fill(form);
</script>