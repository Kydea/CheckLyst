<div id="PrototypesListPage">
    <h1>Prototypes List</h1>

    <div class="ActionBar">
        <a id="ApplyButton" class="Button DefaultButton"><i class="fa fa-search"></i> search</a>
    </div>

    <form id="Filters" action="/API/Prototypes/List">
        <label>
            Name
            <input type="text" name="name" />
        </label>
        <label>
            Department
            <select name="department" class="Trigger" />
        </label>
        <label>
            Prototype Type
            <select name="prototypeType" />
        </label>
        <label>
            State
            <select name="state" />
        </label>
    </form>

    <table class="Grid">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Version</th>
                <th>Validity Start Date</th>
                <th>Validity End Date</th>
                <th>Created By</th>
                <th>Created On</th>
                <th>Modified By</th>
                <th>Modified On</th>
                <th>State</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td data-column="id"></td>
                <td data-column="name"></td>
                <td data-column="description"></td>
                <td data-column="version"></td>
                <td data-column="validityFrom" data-type="DateTimeOffset"></td>
                <td data-column="validityUntil" data-type="DateTimeOffset"></td>
                <td data-column="createdBy"></td>
                <td data-column="createdOn" data-type="DateTimeOffset"></td>
                <td data-column="modifiedBy"></td>
                <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                <td data-column="versionState"></td>
            </tr>
            <tr class="NoRecord"><td>(no record)</td></tr>
        </tbody>
    </table>
    <div class="Paginator"></div>
    <div class="Clearing"></div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        var grid,
            form,
            paginator,
            handler = function (result) {
                grid.update(result.data);
                paginator.setPage(result.currentPage, result.pagesCount);
            };

        new matematici.ActionBar("div.ActionBar");

        new matematici.Page({
            name: "PrototypesList",
            initializers: [
                //new matematici.FixedHeader("div#Content table.Grid")
                grid = new matematici.Grid("div#Content table.Grid"),
                form = new matematici.Form("form#Filters", {
                    applyButton: {
                        button: "#ApplyButton",
                        event: "GetData",
                        handler: handler
                    },
                    bindEvent: "Bind"
                }),
                matematici.p = paginator = new matematici.Paginator("div#Content div.Paginator", function (index) {
                    form.trigger("GetData", handler, { CurrentPage: index });
                })
            ]
        });

        callback.call();
    };
</script>

<script type="text/javascript">
        matematici.events.NO____onPageLoad = function (callback) {
            var
                form = $("form#Filters"),

                handler = function () {
                    matematici.navigator.open("@Url.Action("List")", false, true);
                },

                openPrototypeHandler = function (url) {
                    matematici.navigator.open(url, false, false);
                },

                useAsTemplateHandler = function (url) {
                    matematici.navigator.open(url, false, false);
                },

                createNewVersionHandler = function (data) {
                    $.ajax({
                        url: matematici.urls.prototypes.createNewVersion,
                        type: "post",
                        data: JSON.stringify(data),
                        contentType: "application/json"

                    }).done(function (result) {
                        if (result.error) {
                            matematici.dialog.error("Error", result.message);
                        } else if (result.redirect) {
                            matematici.navigator.open(result.redirect, false, false);
                        } else {
                            handler();
                        }
                    }).fail(function (jqXHR, textStatus, errorThrown) {
                        console.log("Server error", jqXHR, textStatus, errorThrown);
                        alert("Server error: " + errorThrown);
                    });
                },

                submit = function (url) {
                    if (!url)
                        handler();
                    else if (form.valid())
                        $.ajax({
                            url: url,
                            type: "post",
                            data: form.serialize()
                        }).done(function (result) {
                            matematici.events.onPageDestroy();
                            $("#PrototypesListPage").html(result);
                            matematici.events.onPageLoad(callback);
                        }).fail(function (jqXHR, textStatus, errorThrown) {
                            console.log("Server error", jqXHR, textStatus, errorThrown);
                            alert("Server error: " + errorThrown);
                        });
                };

            new matematici.Pager(function () {
                submit("@Url.Action("List")");
            });

            new matematici.ActionBar("div.ActionBar")
                .add("New Empty Prototype", function () {
                    matematici.navigator.open("@Url.Action("Detail", new { IsNew = true })");
                })
                .add("Search", function () {
                    submit("@Url.Action("List")");
                });

            $("table.Grid").on("click", "tr.Handler", function () {
                var buttons = [];
                buttons.push({ text: "cancel", icon: "remove", cancelButton: true });
                if ($(this).data("state") != prototypes.Prototype.states.draft) buttons.push({ text: "new version", icon: "file-o", handler: createNewVersionHandler, data: { code: $(this).data("code"), version: $(this).data("version") } });
                buttons.push({ text: "use as template", icon: "copy", handler: useAsTemplateHandler, data: $(this).data("template-url") });
                buttons.push({ text: "open", icon: "folder-open-o", handler: openPrototypeHandler, data: $(this).data("open-url") });

                matematici.dialog.popupMenu(buttons);
            });

            //Refresh
            $("select, input[type='text']").unbind().on("change", function (e) {
                e.preventDefault();
                submit("@Url.Action("List")");
            });

            callback.call();
        };
</script>
