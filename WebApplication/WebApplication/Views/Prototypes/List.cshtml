<div id="PrototypesListPage">
    <h1>Prototypes List</h1>

    <div class="ActionBar"></div>

    <form id="List" action="/Prototypes/List">
        <label>
            Name
            <input type="text" name="Name" />
        </label>
        <label>
            Department
            <input type="text" name="Department" class="List" />
        </label>
        @*
        <label>
            Department
            @Html.DropDownListFor(m => m.Department, Model.Departments.Select(x => new SelectListItem() { Text = x.Code, Value = x.Code, Selected = Model.Department == x.Code }), null, String.IsNullOrEmpty(Model.Company) ? new { disabled = "disabled" } : null)
        </label>
        <label>
            Prototype Type
            @Html.DropDownListFor(m => m.PrototypeType, Model.PrototypeTypes.Select(x => new SelectListItem() { Text = x.Code, Value = x.Code, Selected = Model.PrototypeType == x.Code }), null, String.IsNullOrEmpty(Model.Department) ? new { disabled = "disabled" } : null)
        </label>
        <label>
            State
            @Html.DropDownListFor(m => m.State, Matematici.Entities.VersionStates.All.Select(x => new SelectListItem() { Text = x.Code, Value = x.Code, Selected = Model.State == x.Code }), "All", null)
        </label>*@
    </form>

    @*
    @if (Model.GridRows.Count > 0)
    {
        <table class="Grid">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Version</th>
                    <th>Validity Start Date (UTC)</th>
                    <th>Validity End Date (UTC)</th>
