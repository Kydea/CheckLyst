<div id="PrototypesListPage">
    <h1>Prototypes List</h1>

    <div class="ActionBar">
        <a id="AddButton" href="#" class="Button"><i class="fi flaticon-plus"></i> New empty prototype</a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Prototypes/List">
            <label>
                Department
                <i class="fi flaticon-building-o" />
                <select name="department" class="Trigger" />
            </label>
            <label>
                Prototype type
                <i class="fi flaticon-folder-o" />
                <select name="prototypeType" />
            </label>
            <label>
                Prototype name
                <i class="fi flaticon-prototype" />
                <input type="text" name="name" />
            </label>
            <label>
                Prototype state
                <i class="fi flaticon-battery" />
                <select name="state" />
            </label>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Version</th>
                    <th>State</th>
                    <th>Validity start date</th>
                    <th>Validity end date</th>
                    <th>Created by</th>
                    <th>Created on</th>
                    <th>Modified by</th>
                    <th>Modified on</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="name"></td>
                    <td data-column="description"></td>
                    <td data-column="version"></td>
                    <td data-column="versionState"></td>
                    <td data-column="validityFrom" data-type="DateTimeOffset"></td>
                    <td data-column="validityUntil" data-type="DateTimeOffset"></td>
                    <td data-column="createdBy"></td>
                    <td data-column="createdOn" data-type="DateTimeOffset"></td>
                    <td data-column="modifiedBy"></td>
                    <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    var
        createNewVersionHandler = function (id) {
            matematici.navigator.open("@Url.Action("Add")/" + id);
        },

        openPrototypeHandler = function (id) {
            matematici.navigator.open("@Url.Action("Detail")/" + id);
        },

        useAsTemplateHandler = function (id) {
            matematici.navigator.open("@Url.Action("Clone")/" + id);
        };

    matematici.events.onPageLoad = function (callback) {
        var searchPage = new matematici.SearchPage({
            pageName: "Prototypes",
            filterFormSelector: "form#Filters",
            resultGridSelector: "div#Content table.Grid",
            bindEvent: "Bind",
            readOnly: true,
            breadCrumbs: [
                { content: "prototypes" }
            ],

            rowClickHandler: function (row) {
                var buttons = [];
                buttons.push({ text: "cancel", icon: "times", cancelButton: true });
                if ($(this).data("state") != prototypes.Prototype.states.draft) buttons.push({ text: "new version", icon: "file-o", handler: createNewVersionHandler, data: row.data("values").id });
                buttons.push({ text: "use as template", icon: "clone-o", handler: useAsTemplateHandler, data: row.data("values").id });
                buttons.push({ text: "open", icon: "folder-open-o", handler: openPrototypeHandler, data: row.data("values").id });

                matematici.dialog.popupMenu(buttons);
            }
        });

        $("#AddButton").on("click", function (e) {
            matematici.navigator.open("@Url.Action("Add")");
        });

        callback.call();
    };
</script>