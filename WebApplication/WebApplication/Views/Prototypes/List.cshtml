    }
    else
    {
        <label class="Clearing">
            No records found.
        </label>
    }*@
</div>

if (!Model.IsPostBack)
{
    <script type="text/javascript">
        matematici.events.onPageLoad = function (callback) {
            var
                form = $("form#List"),

                handler = function () {
                    matematici.navigator.open("@Url.Action("List")", false, true);
                },

                openPrototypeHandler = function (url) {
                    matematici.navigator.open(url, false, false);
                },

                useAsTemplateHandler = function (url) {
                    matematici.navigator.open(url, false, false);
                },

                createNewVersionHandler = function (data) {
                    $.ajax({
                        url: matematici.urls.prototypes.createNewVersion,
                        type: "post",
                        data: JSON.stringify(data),
                        contentType: "application/json"

                    }).done(function (result) {
                        if (result.error) {
                            matematici.dialog.error("Error", result.message);
                        } else if (result.redirect) {
                            matematici.navigator.open(result.redirect, false, false);
                        } else {
                            handler();
                        }
                    }).fail(function (jqXHR, textStatus, errorThrown) {
                        console.log("Server error", jqXHR, textStatus, errorThrown);
                        alert("Server error: " + errorThrown);
                    });
                },

                submit = function (url) {
                    if (!url)
                        handler();
                    else if (form.valid())
                        $.ajax({
                            url: url,
                            type: "post",
                            data: form.serialize()
                        }).done(function (result) {
                            matematici.events.onPageDestroy();
                            $("#PrototypesListPage").html(result);
                            matematici.events.onPageLoad(callback);
                        }).fail(function (jqXHR, textStatus, errorThrown) {
                            console.log("Server error", jqXHR, textStatus, errorThrown);
                            alert("Server error: " + errorThrown);
                        });
                };

            new matematici.Page({
                name: "Prototypes List",
                initializers: [
                    new matematici.FixedHeader("div#Content table.Grid")
                ]
            });

            new matematici.Pager(function () {
                submit("@Url.Action("List")");
            });

            new matematici.ActionBar("div.ActionBar")
                .add("New Empty Prototype", function () {
                    matematici.navigator.open("@Url.Action("Detail", new { IsNew = true })");
                })
                .add("Search", function () {
                    submit("@Url.Action("List")");
                });

            $("table.Grid").on("click", "tr.Handler", function () {
                var buttons = [];
                buttons.push({ text: "cancel", icon: "remove", cancelButton: true });
                if ($(this).data("state") != prototypes.Prototype.states.draft) buttons.push({ text: "new version", icon: "file-o", handler: createNewVersionHandler, data: { code: $(this).data("code"), version: $(this).data("version") } });
                buttons.push({ text: "use as template", icon: "copy", handler: useAsTemplateHandler, data: $(this).data("template-url") });
                buttons.push({ text: "open", icon: "folder-open-o", handler: openPrototypeHandler, data: $(this).data("open-url") });

                matematici.dialog.popupMenu(buttons);
            });

            //Refresh
            $("select, input[type='text']").unbind().on("change", function (e) {
                e.preventDefault();
                submit("@Url.Action("List")");
            });

            callback.call();
        };
    </script>
}