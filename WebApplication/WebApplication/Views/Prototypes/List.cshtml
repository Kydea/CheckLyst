<div id="PrototypesListPage">
    <h1>Prototypes List</h1>

    <div class="ActionBar">
        <a id="AddButton" href="#" class="Button"><i class="fi flaticon-plus"></i> New empty prototype</a>
    </div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl/Prototypes/List">
            <label class="Controls2">
                <span>Prototype type</span>
                <i class="Icon fi flaticon-building-o" />
                <select name="department" class="Trigger" />
                <i class="Icon fi flaticon-folder-o" />
                <select name="prototypeType" />
            </label>
            <label>
                <span>Prototype name</span>

                <i class="Icon fi flaticon-prototype" />
                <input type="text" name="name" />
            </label>
            <label>
                <span>Prototype state</span>
                <i class="Icon fi flaticon-battery" />
                <select name="state" />
            </label>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Version</th>
                    <th>State</th>
                    <th>Validity start date</th>
                    <th>Validity end date</th>
                    <th>Created by</th>
                    <th>Created on</th>
                    <th>Modified by</th>
                    <th>Modified on</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="id"></td>
                    <td data-column="name"></td>
                    <td data-column="description"></td>
                    <td data-column="version"></td>
                    <td data-column="state"></td>
                    <td data-column="validityFrom" data-type="DateTimeOffset"></td>
                    <td data-column="validityUntil" data-type="DateTimeOffset"></td>
                    <td data-column="createdBy"></td>
                    <td data-column="createdOn" data-type="DateTimeOffset"></td>
                    <td data-column="modifiedBy"></td>
                    <td data-column="modifiedOn" data-type="DateTimeOffset"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    var
        createNewVersionHandler = function (data) {
            matematici.navigator.open("@Url.Action("Version")/" + data.id + "/" + data.version);
        },

        openPrototypeHandler = function (data) {
            matematici.navigator.open("@Url.Action("Detail")/" + data.id + "/" + data.version);
        },

        useAsTemplateHandler = function (data) {
            matematici.navigator.open("@Url.Action("Clone")/" + data.id + "/" + data.version);
        };

    matematici.events.onPageLoad = function (callback) {
        var
            editor = matematici.tokenManager.checkRole("Prototypes#Edit#"),
            searchPage = new matematici.SearchPage({
                pageName: "Prototypes",
                filterFormSelector: "form#Filters",
                resultGridSelector: "div#Content table.Grid",
                bindEvent: "Bind",
                readOnly: true,
                breadCrumbs: [
                    { content: "prototypes" }
                ],

                rowClickHandler: function (row) {
                    if (editor) {
                        console.log(row.data("values"));
                        var buttons = [];
                        buttons.push({ text: "cancel", icon: "times", cancelButton: true });
                        if (
                            $(this).data("state") != prototypes.Prototype.states.draft
                            && (
                                matematici.tokenManager.checkRole("Prototypes#Edit#" + row.data("values").department + "##")
                                || matematici.tokenManager.checkRole("Prototypes#Edit#" + row.data("values").department + "#" + row.data("values").prototypeType)
                            )
                        )
                            buttons.push({ text: "new version", icon: "file-o", handler: createNewVersionHandler, data: { id: row.data("values").id, version: row.data("values").version } });
                        buttons.push({ text: "use as template", icon: "clone-o", handler: useAsTemplateHandler, data: { id: row.data("values").id, version: row.data("values").version } });
                        buttons.push({ text: "open", icon: "folder-open-o", handler: openPrototypeHandler, data: { id: row.data("values").id, version: row.data("values").version } });

                        matematici.dialog.popupMenu(buttons);
                    } else
                        openPrototypeHandler({ id: row.data("values").id, version: row.data("values").version });
                }
            }),

            addButton = $("#AddButton").on("click", function (e) {
                matematici.navigator.open("@Url.Action("Create")");
            });

        if (!editor)
            addButton.remove();

        callback.call();
    };
</script>