<div id="ScriptEditor">
    <h2>Script Editor</h2>

    <form id="Detail">
        <label class="Narrow">
            Include items and properties
            <input type="checkbox" id="Items" checked="checked" />
        </label>
        <label class="Narrow">
            Include expressions
            <input type="checkbox" id="Expressions" checked="checked" />
        </label>
        <label class="Narrow">
            Include data sources
            <input type="checkbox" id="DataSources" checked="checked" />
        </label>

        <label class="Clearing FullWidth" style="margin-top: 0;">
            <pre id="AceExpressionEditor" style="width: 100%; min-height: calc(100vh - 300px);"></pre>
        </label>
    </form>
</div>

<script type="text/javascript">
    var
        scriptEditor = matematici.popup.getData(),
        form = $("div#ScriptEditor form#Detail");

    scriptEditor.prepare(form);
</script>