<div id="PrototypesListPage">
    <h1>Prototypes List</h1>

    <div class="ActionBar"></div>

    <div class="ShadowPanel">
        <div class="Accordion"></div>
        <form id="Filters" action="@BaseUrl">
            <label class="Controls2">
                <span>Prototype</span>
                <i class="Icon fi flaticon-building-o"></i>
                <select name="department" class="Trigger" data-nullable="(all)"></select>
                <i class="Icon fi flaticon-folder-o"></i>
                <select name="prototypeType" data-nullable="(all)"></select>
            </label>
            <label>
                <span>Prototype name</span>
                <i class="Icon fi flaticon-prototype"></i>
                <input type="text" name="name" />
            </label>
        </form>

        <table class="Grid">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Prototype type</th>
                    <th>Description</th>
                    <th>Version</th>
                </tr>
            </thead>
            <tbody>
                <tr class="Handler">
                    <td data-column="name"></td>
                    <td data-column="department"></td>
                    <td data-column="prototypeType"></td>
                    <td data-column="description"></td>
                    <td data-column="version"></td>
                </tr>
                <tr class="NoRecord"><td>(no record)</td></tr>
            </tbody>
        </table>
        <div class="Paginator"></div>
        <div class="Clearing"></div>
    </div>
</div>

<script type="text/javascript">
    matematici.events.onPageLoad = function (callback) {
        new matematici.SearchPage({
            pageName: "Prototypes",
            filterFormSelector: "form#Filters",
            resultGridSelector: "div#Content table.Grid",
            readOnly: true,
            bindEvent: "Bind",
            breadCrumbs: [
                { content: "prototypes list" }
            ],

            rowClickHandler: function (row) {
                window.open("/Detail/" + encodeURIComponent(row.data("values").name));
            }
        });

        setTimeout(function () {
            $("select").each(function () {
                $(this).data("autoComplete").refresh();
            });
        }, 0);

        callback.call();
    };
</script>