@model Matematici.ViewModels.Browser.List

<div id="ListPage">
    <h1>Browser</h1>

    <div class="ActionBar"></div>

    <form id="List">
        @Html.HiddenFor(m => m.Page, new { @class = "Page" })
        @Html.HiddenFor(m => m.PagesCount, new { @class = "PagesCount" })

        <label>
            Prototype
            @Html.TextBoxFor(m => m.Prototype)
        </label>
        <label>
            Company
            @Html.DropDownListFor(m => m.Company, Model.Companies.Select(x => new SelectListItem() { Text = x, Value = x, Selected = Model.Company == x }), "(all the companies)")
        </label>
        <label>
            Department
            @Html.DropDownListFor(m => m.Department, Model.Departments.Select(x => new SelectListItem() { Text = x, Value = x, Selected = Model.Department == x }), "(all the departments)", String.IsNullOrEmpty(Model.Company) ? new { disabled = "disabled" } : null)
        </label>
        <label>
            Prototype Type
            @Html.DropDownListFor(m => m.PrototypeType, Model.PrototypeTypes.Select(x => new SelectListItem() { Text = x, Value = x, Selected = Model.PrototypeType == x }), "(all the prototype types)", String.IsNullOrEmpty(Model.Company) || String.IsNullOrEmpty(Model.Department) ? new { disabled = "disabled" } : null)
        </label>
    </form>

    @if (Model.GridRows.Count > 0)
    {
        <table class="Grid">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Version</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var Row in Model.GridRows)
                {
                    <tr class="Handler" data-url="@Url.Action("Detail", new { FileName = Row.FileName })">
                        <td>
                            @Row.Code
                        </td>
                        <td>
                            @Row.Description
                        </td>
                        <td>
                            @Row.Version
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="Pager"></div>
            <div style="clear:both"></div>
    }
    else
    {
        <label class="Clearing">
            No records found.
        </label>
    }
</div>

@if (!Model.IsPostBack)
{
    <script type="text/javascript">
        matematici.events.onPageLoad = function (callback) {
            var
                form = $("form#List"),

                submit = function () {
                    if (form.size() > 0 && form.valid())
                        $.ajax({
                            url: "/List",
                            type: "post",
                            data: form.serialize()
                        }).done(function (result) {
                            matematici.events.onPageDestroy();
                            $("#ListPage").html(result);
                            matematici.events.onPageLoad(callback);
                        }).fail(function (jqXHR, textStatus, errorThrown) {
                            console.log("Server error", jqXHR, textStatus, errorThrown);
                            alert("Server error: " + errorThrown);
                        });
                };

            new matematici.Page({
                name: "Prototypes List",
                initializers: [
                    new matematici.FixedHeader("div#Content table.Grid")
                ]
            });

            new matematici.Pager(function () {
                submit();
            });

            new matematici.ActionBar("div.ActionBar")
                .add("Search", function () {
                    console.log("search")
                    submit();
                });

            $("table.Grid").on("click", "tr.Handler", function (e) {
                e.preventDefault();
                window.open($(this).data("url"));
                //matematici.navigator.open($(this).data("url"), false, false)
            });

            $("select, input[type='text']").unbind().on("change", function (e) {
                e.preventDefault();
                submit();
            });

            callback.call();
        };
    </script>
}